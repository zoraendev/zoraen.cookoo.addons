<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_zrn_commercial_brand_search" model="ir.ui.view">
        <field name="name">zrn_commercial.commercial.brand.search</field>
        <field name="model">zrn_commercial.commercial.brand</field>
        <field name="arch" type="xml">
            <search string="Marcas">
                <field name="name"/>
                <field name="code"/>
                <field name="business_unit_id"/>
                <group>
                    <filter string="Unidad de negocio" name="group_business_unit" context="{'group_by': 'business_unit_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_zrn_commercial_brand_list" model="ir.ui.view">
        <field name="name">zrn_commercial.commercial.brand.list</field>
        <field name="model">zrn_commercial.commercial.brand</field>
        <field name="arch" type="xml">
            <tree string="Marcas">
                <field name="business_unit_id"/>
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="category_count" string="Categorias"/>
                <field name="product_count" string="Productos"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_zrn_commercial_brand_category_form" model="ir.ui.view">
        <field name="name">zrn_commercial.commercial.brand.category.form</field>
        <field name="model">zrn_commercial.commercial.brand.category</field>
        <field name="arch" type="xml">
            <form string="Categoria de marca">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre de la categoria"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="brand_id" options="{'no_create_edit': True}"/>
                            <field name="code"/>
                            <field name="category_type"/>
                            <field name="price_tier"/>
                        </group>
                        <group>
                            <field name="positioning"/>
                            <field name="target_market"/>
                            <field name="product_count" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Productos">
                            <field name="available_product_ids" invisible="1"/>
                            <field
                                name="product_ids"
                                domain="[('id', 'in', available_product_ids)]"
                                context="{'default_sale_ok': True}"
                                options="{'no_create_edit': True}"
                            >
                                <tree string="Productos">
                                    <field name="default_code" optional="show"/>
                                    <field name="name"/>
                                    <field name="product_tmpl_id" optional="hide"/>
                                    <field name="uom_id" optional="show"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Atributos">
                            <group>
                                <field name="description" placeholder="Descripcion general de la categoria"/>
                                <field name="notes" placeholder="Notas internas"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_zrn_commercial_brand_form" model="ir.ui.view">
        <field name="name">zrn_commercial.commercial.brand.form</field>
        <field name="model">zrn_commercial.commercial.brand</field>
        <field name="arch" type="xml">
            <form string="Marca">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre de la marca"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="business_unit_id" required="1" options="{'no_create_edit': True}"/>
                            <field name="code"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field
                                name="logo"
                                widget="image"
                                class="oe_avatar"
                                help="Formatos permitidos: PNG, JPG/JPEG o WEBP. Tamano maximo: 5 MB."
                            />
                        </group>
                    </group>
                    <notebook>
                        <page string="Categorias">
                            <field name="category_ids" context="{'default_brand_id': id}">
                                <tree string="Categorias">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="code" optional="show"/>
                                    <field name="category_type"/>
                                    <field name="price_tier" optional="show"/>
                                    <field name="positioning" optional="hide"/>
                                    <field name="target_market" optional="hide"/>
                                    <field name="product_count" readonly="1"/>
                                </tree>
                                <form string="Categoria de marca">
                                    <sheet>
                                        <div class="oe_title">
                                            <h1>
                                                <field name="name" placeholder="Nombre de la categoria"/>
                                            </h1>
                                        </div>
                                        <group>
                                            <group>
                                                <field name="sequence"/>
                                                <field name="code"/>
                                                <field name="category_type"/>
                                                <field name="price_tier"/>
                                            </group>
                                            <group>
                                                <field name="positioning"/>
                                                <field name="target_market"/>
                                                <field name="product_count" readonly="1"/>
                                            </group>
                                        </group>
                                        <notebook>
                                            <page string="Productos">
                                                <field name="available_product_ids" invisible="1"/>
                                                <field
                                                    name="product_ids"
                                                    domain="[('id', 'in', available_product_ids)]"
                                                    context="{'default_sale_ok': True}"
                                                    options="{'no_create_edit': True}"
                                                >
                                                    <tree string="Productos">
                                                        <field name="default_code" optional="show"/>
                                                        <field name="name"/>
                                                        <field name="product_tmpl_id" optional="hide"/>
                                                        <field name="uom_id" optional="show"/>
                                                    </tree>
                                                </field>
                                            </page>
                                            <page string="Atributos">
                                                <group>
                                                    <field name="description" placeholder="Descripcion general de la categoria"/>
                                                    <field name="notes" placeholder="Notas internas"/>
                                                </group>
                                            </page>
                                        </notebook>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_zrn_commercial_brands" model="ir.actions.act_window">
        <field name="name">Marcas</field>
        <field name="res_model">zrn_commercial.commercial.brand</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_zrn_commercial_brand_list"/>
        <field name="search_view_id" ref="view_zrn_commercial_brand_search"/>
        <field name="target">current</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primera marca
            </p>
        </field>
    </record>
</odoo>
