<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="zrn_planning_delivery_planning_default" model="zrn_planning.delivery.planning">
        <field name="name">Planeacion Logistica</field>
    </record>

    <record id="view_zrn_planning_delivery_planning_form" model="ir.ui.view">
        <field name="name">zrn_planning.delivery.planning.form</field>
        <field name="model">zrn_planning.delivery.planning</field>
        <field name="arch" type="xml">
            <form string="Planeacion Logistica" js_class="zrn_planning_form" create="0" edit="0" delete="0" duplicate="0" class="zrn_planning_submodule_form zrn_planning_delivery_planning_form">
                <sheet>
                    <field name="name" invisible="1"/>
                    <div class="zrn_planning_submodule_nav">
                        <button
                            name="action_open_home"
                            type="object"
                            icon="fa-arrow-left"
                            string="Volver a Planeacion"
                            class="btn zrn_planning_back_btn"
                        />
                    </div>
                    <div class="oe_title">
                        <h1>Planeacion Logistica</h1>
                    </div>
                    <div class="zrn_planning_building_state">
                        <div class="zrn_planning_building_loader" aria-hidden="true">
                            <span class="zrn_planning_building_loader_ring zrn_planning_building_loader_ring_outer"/>
                            <span class="zrn_planning_building_loader_ring zrn_planning_building_loader_ring_inner"/>
                            <span class="zrn_planning_building_loader_core"/>
                        </div>
                        <div class="zrn_planning_building_copy">
                            <div class="zrn_planning_building_kicker">Workspace en progreso</div>
                            <div class="zrn_planning_building_title">Estamos preparando esta vista</div>
                            <div class="zrn_planning_building_messages" aria-live="polite">
                                <span>Construyendo el tablero logistico...</span>
                                <span>Orquestando rutas, despachos y cobertura...</span>
                                <span>Preparando widgets de control y visibilidad...</span>
                                <span>Montando la experiencia operativa del modulo...</span>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_zrn_planning_delivery_planning" model="ir.actions.act_window">
        <field name="name">Planeacion Logistica</field>
        <field name="res_model">zrn_planning.delivery.planning</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_zrn_planning_delivery_planning_form"/>
        <field name="res_id" ref="zrn_planning_delivery_planning_default"/>
        <field name="target">current</field>
    </record>

</odoo>
