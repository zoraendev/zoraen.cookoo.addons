<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="zrn_planning_home_default" model="zrn_planning.home">
        <field name="name">(ZRN) Planeacion</field>
        <field name="sequence">10</field>
        <field name="page_key">overview</field>
    </record>

    <record id="view_zrn_planning_home_form" model="ir.ui.view">
        <field name="name">zrn_planning.home.form</field>
        <field name="model">zrn_planning.home</field>
        <field name="arch" type="xml">
            <form string="(ZRN) Planeacion" js_class="zrn_planning_form" create="0" edit="0" delete="0" duplicate="0" class="zrn_planning_submodule_form zrn_planning_production_planning_form zrn_planning_home_form">
                <sheet>
                    <field name="name" invisible="1"/>
                    <field name="page_key" invisible="1"/>
                    <field name="sequence" invisible="1"/>

                    <div class="zrn_planning_home_shell">
                        <div class="zrn_planning_home_toolbar">
                            <div class="zrn_planning_home_menu zrn_planning_home_menu_top">
                                <button
                                    name="action_open_production_planning"
                                    type="object"
                                    icon="fa-industry"
                                    string="Produccion"
                                    class="btn zrn_planning_menu_btn zrn_planning_menu_btn_secondary"
                                />
                                <button
                                    name="action_open_supply_planning"
                                    type="object"
                                    icon="fa-shopping-cart"
                                    string="Abastecimiento"
                                    class="btn zrn_planning_menu_btn zrn_planning_menu_btn_secondary"
                                />
                                <button
                                    name="action_open_inventory_reconciliation"
                                    type="object"
                                    icon="fa-balance-scale"
                                    string="Cuadre Inventario"
                                    class="btn zrn_planning_menu_btn zrn_planning_menu_btn_secondary"
                                />
                            </div>
                            <div class="zrn_planning_home_quickstats zrn_planning_home_quickstats_top">
                                <div class="zrn_planning_menu_btn zrn_planning_menu_btn_metric zrn_planning_menu_btn_metric_brand">
                                    <span class="zrn_planning_home_stat_label">Planes</span>
                                    <span class="zrn_planning_home_stat_value">
                                        <field name="active_plan_count" readonly="1" nolabel="1"/>
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="zrn_planning_home_dashboard">
                            <div class="zrn_planning_home_previews zrn_planning_home_previews_summary">
                                <div class="zrn_planning_home_panel">
                                    <div class="zrn_planning_home_panel_head">
                                        <span>Ultimos planes de fabricacion</span>
                                        <strong><field name="recent_production_plan_count" readonly="1" nolabel="1"/></strong>
                                    </div>
                                    <div class="zrn_planning_home_panel_body">
                                        <div class="zrn_planning_home_panel_split">
                                            <div class="zrn_planning_plans_list_container zrn_planning_home_plans_list_container">
                                                <field name="recent_production_plan_ids" readonly="1" nolabel="1"
                                                       context="{'form_view_ref': 'zrn_planning.view_zrn_planning_mfg_plan_form'}">
                                                    <tree limit="7" create="0" delete="0" edit="0">
                                                        <field name="name" string="Nombre del plan"/>
                                                        <field name="date_start" string="Inicio"/>
                                                        <field name="date_end" string="Fin"/>
                                                        <field name="production_count" string="OFs"/>
                                                        <field name="completed_production_count" string="OFs finalizadas"/>
                                                        <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'approved'"/>
                                                    </tree>
                                                </field>
                                            </div>
                                            <div class="zrn_planning_home_chart_container">
                                                <div class="zrn_planning_home_chart_head">
                                                    <span>Avance global</span>
                                                    <div class="zrn_planning_home_chart_switch" data-chart-key="production">
                                                        <a href="#" role="button" class="btn btn-sm zrn_planning_home_chart_type is-active" data-zrn-chart-type="bar">Barras</a>
                                                        <a href="#" role="button" class="btn btn-sm zrn_planning_home_chart_type" data-zrn-chart-type="line">Linea</a>
                                                        <a href="#" role="button" class="btn btn-sm zrn_planning_home_chart_type" data-zrn-chart-type="pie">Pie</a>
                                                    </div>
                                                </div>
                                                <div class="zrn_planning_home_chart_hint">Comparativo entre planes creados, ordenes generadas y ordenes finalizadas.</div>
                                                <div class="zrn_planning_home_chart_canvas" data-zrn-planning-chart="production"></div>
                                                <div class="zrn_planning_home_chart_empty d-none" data-zrn-planning-chart-empty="production">
                                                    Sin datos suficientes para graficar.
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="zrn_planning_home_panel">
                                    <div class="zrn_planning_home_panel_head">
                                        <span>Ultimos planes de abastecimiento</span>
                                        <strong><field name="recent_supply_plan_count" readonly="1" nolabel="1"/></strong>
                                    </div>
                                    <div class="zrn_planning_home_panel_body">
                                        <div class="zrn_planning_home_panel_split">
                                            <div class="zrn_planning_plans_list_container zrn_planning_home_plans_list_container">
                                                <field name="recent_supply_plan_ids" readonly="1" nolabel="1"
                                                       context="{'form_view_ref': 'zrn_planning.view_zrn_planning_supply_plan_form'}">
                                                    <tree limit="7" create="0" delete="0" edit="0">
                                                        <field name="name" string="Nombre del plan"/>
                                                        <field name="date_start" string="Inicio"/>
                                                        <field name="date_end" string="Fin"/>
                                                        <field name="purchase_count" string="OCs"/>
                                                        <field name="completed_purchase_count" string="OCs finalizadas"/>
                                                        <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'approved'"/>
                                                    </tree>
                                                </field>
                                            </div>
                                            <div class="zrn_planning_home_chart_container">
                                                <div class="zrn_planning_home_chart_head">
                                                    <span>Avance global</span>
                                                    <div class="zrn_planning_home_chart_switch" data-chart-key="supply">
                                                        <a href="#" role="button" class="btn btn-sm zrn_planning_home_chart_type is-active" data-zrn-chart-type="bar">Barras</a>
                                                        <a href="#" role="button" class="btn btn-sm zrn_planning_home_chart_type" data-zrn-chart-type="line">Linea</a>
                                                        <a href="#" role="button" class="btn btn-sm zrn_planning_home_chart_type" data-zrn-chart-type="pie">Pie</a>
                                                    </div>
                                                </div>
                                                <div class="zrn_planning_home_chart_hint">Comparativo entre planes creados, ordenes generadas y ordenes finalizadas.</div>
                                                <div class="zrn_planning_home_chart_canvas" data-zrn-planning-chart="supply"></div>
                                                <div class="zrn_planning_home_chart_empty d-none" data-zrn-planning-chart-empty="supply">
                                                    Sin datos suficientes para graficar.
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_zrn_planning_home" model="ir.actions.act_window">
        <field name="name">(ZRN) Planeacion</field>
        <field name="res_model">zrn_planning.home</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_zrn_planning_home_form"/>
        <field name="res_id" ref="zrn_planning_home_default"/>
        <field name="target">current</field>
    </record>

    <menuitem
        id="menu_zrn_planning_root"
        name="(ZRN) Planeacion"
        sequence="10"
        action="action_zrn_planning_home"
        web_icon="zrn_planning,static/description/icon.png"
    />

    <record id="action_server_open_production_wizard" model="ir.actions.server">
        <field name="name">Abrir planeacion de fabricacion</field>
        <field name="model_id" ref="model_zrn_planning_production_planning_wizard"/>
        <field name="state">code</field>
        <field name="code">
wizard = env['zrn_planning.production.planning.wizard'].create({})
action = wizard.action_open_filters()
        </field>
    </record>

    <record id="action_server_open_purchase_wizard" model="ir.actions.server">
        <field name="name">Abrir planeacion de abastecimiento</field>
        <field name="model_id" ref="model_zrn_planning_purchase_planning_wizard"/>
        <field name="state">code</field>
        <field name="code">
wizard = env['zrn_planning.purchase.planning.wizard'].create({})
action = wizard.action_open_filters()
        </field>
    </record>

    <menuitem
        id="menu_zrn_planning_production"
        name="Produccion"
        parent="menu_zrn_planning_root"
        sequence="20"
        action="action_server_open_production_wizard"
    />

    <menuitem
        id="menu_zrn_planning_supply"
        name="Abastecimiento"
        parent="menu_zrn_planning_root"
        sequence="30"
        action="action_server_open_purchase_wizard"
    />

</odoo>
