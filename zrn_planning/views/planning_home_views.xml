<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="zrn_planning_home_default" model="zrn_planning.home">
        <field name="name">(ZRN) Planeacion</field><field name="sequence">10</field><field name="page_key">overview</field>
    </record>
    <record id="view_zrn_planning_home_form" model="ir.ui.view">
        <field name="name">zrn_planning.home.form</field><field name="model">zrn_planning.home</field>
        <field name="arch" type="xml">
            <form string="(ZRN) Planeacion" js_class="zrn_planning_form" create="0" edit="0" delete="0" duplicate="0" class="zrn_planning_home_form">
                <sheet>
                    <field name="name" invisible="1"/><field name="page_key" invisible="1"/><field name="sequence" invisible="1"/>
                    <div class="zrn_planning_home_dashboard">
                        <div class="zrn_planning_home_grid">
                            <section class="zrn_planning_home_panel" data-zrn-planning-home-panel="production">
                                <div class="zrn_planning_home_panel_head"><strong>Produccion</strong></div>
                                <div class="zrn_planning_home_metrics" data-zrn-planning-home-metrics="production"/>
                                <div class="zrn_planning_home_visual_head"><span>Vista de planes</span><div class="zrn_planning_home_panel_actions">
                                    <a href="#" role="button" class="btn zrn_planning_home_icon_btn" data-zrn-planning-home-view="production:chart" aria-label="Ver grafica"><i class="fa fa-bar-chart"/></a>
                                    <a href="#" role="button" class="btn zrn_planning_home_icon_btn" data-zrn-planning-home-export="production" aria-label="Exportar"><i class="fa fa-download"/></a>
                                    <a href="#" role="button" class="btn zrn_planning_home_icon_btn" data-zrn-planning-home-view="production:table" aria-label="Ver tabla"><i class="fa fa-table"/></a>
                                    <button name="action_open_production_planning" type="object" class="btn zrn_planning_home_icon_btn zrn_planning_home_nav_btn" aria-label="Abrir produccion"><i class="fa fa-arrow-right"/></button>
                                </div></div>
                                <div class="zrn_planning_home_table_mount" data-zrn-planning-home-table="production"/>
                                <div class="zrn_planning_home_chart_canvas d-none" data-zrn-planning-home-chart="production"/>
                                <div class="zrn_planning_home_chart_empty d-none" data-zrn-planning-home-empty="production">Sin datos de produccion.</div>
                            </section>
                            <section class="zrn_planning_home_panel" data-zrn-planning-home-panel="supply">
                                <div class="zrn_planning_home_panel_head"><strong>Abastecimiento</strong></div>
                                <div class="zrn_planning_home_metrics" data-zrn-planning-home-metrics="supply"/>
                                <div class="zrn_planning_home_visual_head"><span>Vista de planes</span><div class="zrn_planning_home_panel_actions">
                                    <a href="#" role="button" class="btn zrn_planning_home_icon_btn" data-zrn-planning-home-view="supply:chart" aria-label="Ver grafica"><i class="fa fa-bar-chart"/></a>
                                    <a href="#" role="button" class="btn zrn_planning_home_icon_btn" data-zrn-planning-home-export="supply" aria-label="Exportar"><i class="fa fa-download"/></a>
                                    <a href="#" role="button" class="btn zrn_planning_home_icon_btn" data-zrn-planning-home-view="supply:table" aria-label="Ver tabla"><i class="fa fa-table"/></a>
                                    <button name="action_open_supply_planning" type="object" class="btn zrn_planning_home_icon_btn zrn_planning_home_nav_btn" aria-label="Abrir abastecimiento"><i class="fa fa-arrow-right"/></button>
                                </div></div>
                                <div class="zrn_planning_home_table_mount" data-zrn-planning-home-table="supply"/>
                                <div class="zrn_planning_home_chart_canvas d-none" data-zrn-planning-home-chart="supply"/>
                                <div class="zrn_planning_home_chart_empty d-none" data-zrn-planning-home-empty="supply">Sin datos de abastecimiento.</div>
                            </section>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_zrn_planning_home" model="ir.actions.act_window">
        <field name="name">(ZRN) Planeacion</field><field name="res_model">zrn_planning.home</field><field name="view_mode">form</field><field name="view_id" ref="view_zrn_planning_home_form"/><field name="res_id" ref="zrn_planning_home_default"/><field name="target">current</field>
    </record>
    <menuitem id="menu_zrn_planning_root" name="(ZRN) Planeacion" sequence="10" action="action_zrn_planning_home" web_icon="zrn_planning,static/description/icon.png"/>
    <record id="action_server_open_production_wizard" model="ir.actions.server">
        <field name="name">Abrir planeacion de fabricacion</field><field name="model_id" ref="model_zrn_planning_production_planning_wizard"/><field name="state">code</field>
        <field name="code">wizard = env['zrn_planning.production.planning.wizard'].create({})
action = wizard.action_open_filters()</field>
    </record>
    <record id="action_server_open_purchase_wizard" model="ir.actions.server">
        <field name="name">Abrir planeacion de abastecimiento</field><field name="model_id" ref="model_zrn_planning_purchase_planning_wizard"/><field name="state">code</field>
        <field name="code">wizard = env['zrn_planning.purchase.planning.wizard'].create({})
action = wizard.action_open_filters()</field>
    </record>
    <menuitem id="menu_zrn_planning_production" name="Produccion" parent="menu_zrn_planning_root" sequence="20" action="action_server_open_production_wizard"/>
    <menuitem id="menu_zrn_planning_supply" name="Abastecimiento" parent="menu_zrn_planning_root" sequence="30" action="action_server_open_purchase_wizard"/>
</odoo>
