<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="zrn_analitics_home_default" model="zrn_analitics.home">
        <field name="name">(ZRN) Analitica</field>
        <field name="sequence">10</field>
        <field name="page_key">overview</field>
    </record>

    <record id="zrn_analitics_workspace_default" model="zrn_analitics.home">
        <field name="name">(ZRN) Analitica</field>
        <field name="sequence">20</field>
        <field name="page_key">workspace</field>
    </record>

    <record id="zrn_analitics_processing_default" model="zrn_analitics.home">
        <field name="name">(ZRN) Analitica</field>
        <field name="sequence">25</field>
        <field name="page_key">processing</field>
    </record>

    <record id="zrn_analitics_processing_workspace_default" model="zrn_analitics.home">
        <field name="name">(ZRN) Analitica</field>
        <field name="sequence">26</field>
        <field name="page_key">processing_workspace</field>
    </record>

    <record id="zrn_analitics_scenarios_default" model="zrn_analitics.home">
        <field name="name">(ZRN) Analitica</field>
        <field name="sequence">30</field>
        <field name="page_key">scenarios</field>
    </record>

    <record id="view_zrn_analitics_home_form" model="ir.ui.view">
        <field name="name">zrn_analitics.home.form</field>
        <field name="model">zrn_analitics.home</field>
        <field name="arch" type="xml">
            <form string="(ZRN) Analitica" js_class="zrn_analitics_form" create="0" edit="0" delete="0" duplicate="0" class="zrn_analitics_form_shell">
                <sheet>
                    <field name="name" invisible="1"/>
                    <field name="page_key" invisible="1"/>
                    <field name="sequence" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_zrn_analitics_home" model="ir.actions.act_window">
        <field name="name">(ZRN) Analitica</field>
        <field name="res_model">zrn_analitics.home</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_zrn_analitics_home_form"/>
        <field name="res_id" ref="zrn_analitics_home_default"/>
        <field name="target">current</field>
        <field name="context" eval="{'active_id': ref('zrn_analitics_home_default'), 'active_ids': [ref('zrn_analitics_home_default')]}"/>
    </record>

    <record id="action_zrn_analitics_workspace" model="ir.actions.act_window">
        <field name="name">Workspace Analitico</field>
        <field name="res_model">zrn_analitics.home</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_zrn_analitics_home_form"/>
        <field name="res_id" ref="zrn_analitics_workspace_default"/>
        <field name="target">current</field>
        <field name="context" eval="{'active_id': ref('zrn_analitics_workspace_default'), 'active_ids': [ref('zrn_analitics_workspace_default')]}"/>
    </record>

    <record id="action_zrn_analitics_processing" model="ir.actions.act_window">
        <field name="name">Procesamiento</field>
        <field name="res_model">zrn_analitics.home</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_zrn_analitics_home_form"/>
        <field name="res_id" ref="zrn_analitics_processing_default"/>
        <field name="target">current</field>
        <field name="context" eval="{'active_id': ref('zrn_analitics_processing_default'), 'active_ids': [ref('zrn_analitics_processing_default')]}"/>
    </record>

    <record id="action_zrn_analitics_processing_workspace" model="ir.actions.act_window">
        <field name="name">Procesamiento Workspace</field>
        <field name="res_model">zrn_analitics.home</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_zrn_analitics_home_form"/>
        <field name="res_id" ref="zrn_analitics_processing_workspace_default"/>
        <field name="target">current</field>
        <field name="context" eval="{'active_id': ref('zrn_analitics_processing_workspace_default'), 'active_ids': [ref('zrn_analitics_processing_workspace_default')]}"/>
    </record>

    <record id="action_zrn_analitics_scenarios" model="ir.actions.act_window">
        <field name="name">Escenarios</field>
        <field name="res_model">zrn_analitics.home</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_zrn_analitics_home_form"/>
        <field name="res_id" ref="zrn_analitics_scenarios_default"/>
        <field name="target">current</field>
        <field name="context" eval="{'active_id': ref('zrn_analitics_scenarios_default'), 'active_ids': [ref('zrn_analitics_scenarios_default')]}"/>
    </record>

    <menuitem
        id="menu_zrn_analitics_root"
        name="(ZRN) Analitica"
        sequence="15"
        action="action_zrn_analitics_home"
        web_icon="zrn_analitics,static/description/icon.png"
    />

    <menuitem
        id="menu_zrn_analitics_workspace"
        name="Hubs"
        parent="menu_zrn_analitics_root"
        sequence="20"
        action="action_zrn_analitics_hubs"
    />

    <menuitem
        id="menu_zrn_analitics_processing"
        name="Procesamiento"
        parent="menu_zrn_analitics_root"
        sequence="25"
        action="action_zrn_analitics_processing"
    />

    <record id="menu_zrn_analitics_scenarios" model="ir.ui.menu">
        <field name="name">Escenarios</field>
        <field name="active" eval="False"/>
    </record>

</odoo>
