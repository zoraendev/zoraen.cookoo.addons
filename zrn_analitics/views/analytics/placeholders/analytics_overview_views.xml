<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_zrn_analitics_home_form_overview" model="ir.ui.view">
        <field name="name">zrn_analitics.home.form.overview</field>
        <field name="model">zrn_analitics.home</field>
        <field name="inherit_id" ref="zrn_analitics.view_zrn_analitics_home_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <div class="zrn_analitics_shell" invisible="page_key != 'overview'">
                    <div class="zrn_analitics_home_cards">
                        <section class="zrn_analitics_home_card">
                            <div class="zrn_analitics_home_card_head">
                                <span class="zrn_analitics_home_card_title">
                                    <i class="fa fa-th-large" aria-hidden="true"/> Hubs
                                </span>
                            </div>
                            <div class="zrn_analitics_home_card_body">
                                <div class="zrn_analitics_home_card_intro">
                                    <strong>Hubs analiticos</strong>
                                    <span>Accede a las vistas de Comercial, Financiero, Operaciones, PDV / Cobertura y RRHH.</span>
                                </div>
                                <div class="zrn_analitics_home_card_list">
                                    <span>Comercial</span>
                                    <span>Financiero</span>
                                    <span>Operaciones</span>
                                    <span>PDV / Cobertura</span>
                                    <span>RRHH</span>
                                </div>
                                <div class="zrn_analitics_home_card_meta">
                                    <span class="zrn_analitics_home_chip">Excel</span>
                                    <span class="zrn_analitics_home_chip">CSV</span>
                                    <span class="zrn_analitics_home_chip">XML</span>
                                    <span class="zrn_analitics_home_chip">Sheets</span>
                                    <span class="zrn_analitics_home_chip">JSON</span>
                                </div>
                                <button
                                    name="action_open_hubs"
                                    type="object"
                                    icon="fa-th-large"
                                    string="Abrir hubs"
                                    class="btn zrn_analitics_menu_btn zrn_analitics_menu_btn_primary"
                                />
                            </div>
                        </section>

                        <section class="zrn_analitics_home_card">
                            <div class="zrn_analitics_home_card_head">
                                <span class="zrn_analitics_home_card_title">
                                    <i class="fa fa-database" aria-hidden="true"/> Retail Link Walmart
                                </span>
                            </div>
                            <div class="zrn_analitics_home_card_body">
                                <div class="zrn_analitics_home_card_intro">
                                    <strong>Carga y valida fuentes</strong>
                                    <span>Prepara archivos y consultas para comparar con los datos de Retail Link Walmart.</span>
                                </div>
                                <div class="zrn_analitics_home_card_list">
                                    <span>Importacion de archivos</span>
                                    <span>Validacion y limpieza</span>
                                    <span>Transformacion de datos</span>
                                    <span>Lectura estructurada</span>
                                </div>
                                <div class="zrn_analitics_home_card_meta">
                                    <span class="zrn_analitics_home_chip">Excel</span>
                                    <span class="zrn_analitics_home_chip">CSV</span>
                                    <span class="zrn_analitics_home_chip">XML</span>
                                    <span class="zrn_analitics_home_chip">Sheets</span>
                                    <span class="zrn_analitics_home_chip">JSON</span>
                                </div>
                                <button
                                    name="action_open_processing"
                                    type="object"
                                    icon="fa-database"
                                    string="Abrir procesamiento"
                                    class="btn zrn_analitics_menu_btn zrn_analitics_menu_btn_tertiary"
                                />
                            </div>
                        </section>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
