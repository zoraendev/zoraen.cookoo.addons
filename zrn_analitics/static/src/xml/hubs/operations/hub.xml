<?xml version='1.0' encoding='UTF-8'?>
<templates xml:space="preserve"><t t-name="zrn_analitics.HubOperations">
        <div class="zrn_analitics_operations_hub" t-ref="hubRoot">
            <div class="zrn_analitics_operations_hero">
                <div class="zrn_analitics_operations_title_row">
                    <div class="zrn_analitics_hub_panel_title">Hub Operaciones</div>
                </div>
            </div>

            <div class="zrn_analitics_operations_shell">
                <button type="button" class="btn zrn_analitics_operations_sidebar_toggle" t-on-click="toggleCommercialSidebar">
                    <i class="fa fa-bars"/>
                    <span>Secciones</span>
                </button>

                <div class="zrn_analitics_operations_sidebar_overlay" t-att-class="state.commercialSidebarOpen ? 'is-open' : ''" t-on-click="closeCommercialSidebar"/>

                <aside class="zrn_analitics_operations_sidebar" t-att-class="state.commercialSidebarOpen ? 'is-open' : ''">
                    <div class="zrn_analitics_operations_sidebar_head">
                        <div class="zrn_analitics_operations_sidebar_title">Secciones</div>
                        <button type="button" class="btn zrn_analitics_operations_sidebar_close" t-on-click="closeCommercialSidebar">
                            <i class="fa fa-times"/>
                        </button>
                    </div>

                    <div class="zrn_analitics_operations_badges zrn_analitics_operations_badges_sidebar">
                        <span class="zrn_analitics_operations_badge zrn_analitics_operations_badge_sync">
                            Sync con Odoo: <t t-esc="activeHubSummary.sync_label"/>
                        </span>
                        <span class="zrn_analitics_operations_badge">
                            <t t-esc="activeHubSummary.period_label"/>
                        </span>
                        <span class="zrn_analitics_operations_badge">
                            <t t-esc="formatCount(operationsPayload.summary.brand_count)"/> marcas / <t t-esc="formatCount(operationsPayload.summary.product_count)"/> productos
                        </span>
                    </div>

                    <div class="zrn_analitics_operations_section_tabs">
                        <t t-foreach="operationsTabs" t-as="tab" t-key="tab.key">
                            <button type="button" class="btn zrn_analitics_operations_section_tab" t-att-class="state.operationsTab === tab.key ? 'is-active' : ''" t-on-click="() =&gt; this.setOperationsTab(tab.key)">
                                <i class="fa zrn_analitics_operations_section_tab_icon" t-att-class="tab.icon"/>
                                <span><t t-esc="tab.label"/></span>
                            </button>
                        </t>
                    </div>
                </aside>

                <div class="zrn_analitics_operations_content">
                    <t t-if="state.operationsLoading">
                        <div class="zrn_analitics_hub_panel">
                            <div class="zrn_analitics_hub_panel_text">Cargando resumen operativo...</div>
                        </div>
                    </t>

                    <t t-if="!state.operationsLoading">
                        <t t-call="zrn_analitics.HubOperationsFilters"/>

                        <div class="zrn_analitics_commercial_summary_table_wrap">
                            <table class="table table-sm zrn_analitics_commercial_summary_table mb-0">
                                <thead>
                                    <tr>
                                        <th>Unidades vendidas</th>
                                        <th>Revenue</th>
                                        <th>Pedidos</th>
                                        <th>PDVs</th>
                                        <th>SKUs activos</th>
                                        <th>Promedio unid/dia</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><strong><t t-esc="formatCount(operationsPayload.summary.total_units)"/></strong></td>
                                        <td><strong><t t-esc="operationsPayload.summary.currency_symbol"/> <t t-esc="formatMoney(operationsPayload.summary.total_revenue)"/></strong></td>
                                        <td><strong><t t-esc="formatCount(operationsPayload.summary.order_count)"/></strong></td>
                                        <td><strong><t t-esc="formatCount(operationsPayload.summary.point_count)"/></strong></td>
                                        <td><strong><t t-esc="formatCount(operationsPayload.summary.product_count)"/></strong></td>
                                        <td><strong><t t-esc="formatCount(operationsPayload.summary.avg_units_day)"/></strong></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <t t-if="operationsPayload.empty_message">
                            <div class="zrn_analitics_operations_empty_note">
                                <t t-esc="operationsPayload.empty_message"/>
                            </div>
                        </t>

                        <t t-call="zrn_analitics.HubOperationsTabOverview"/>

                        <t t-call="zrn_analitics.HubOperationsTabDemanda"/>

                        <t t-call="zrn_analitics.HubOperationsTabAbc"/>

                        <t t-call="zrn_analitics.HubOperationsTabPortafolio"/>

                        <t t-call="zrn_analitics.HubOperationsTabTendencias"/>

                        <t t-call="zrn_analitics.HubOperationsTabForecast"/>

                        <t t-call="zrn_analitics.HubOperationsTabInventarios"/>

                        <t t-call="zrn_analitics.HubOperationsTabCompras"/>

                        <t t-call="zrn_analitics.HubOperationsTabAlertas"/>

                        <t t-if="state.analyticsDetailModal">
                            <div class="modal-backdrop fade show zrn_analitics_commercial_modal_backdrop" t-on-click="closeAnalyticsDetailModal"/>
                            <div class="modal fade show d-block zrn_analitics_commercial_modal_shell" tabindex="-1" role="dialog">
                                <div class="modal-dialog modal-xl modal-dialog-scrollable" role="document" t-on-click.stop="() =&gt; {}">
                                    <div class="modal-content zrn_analitics_commercial_modal" t-on-click.stop="() =&gt; {}">
                                        <div class="modal-header">
                                            <div>
                                                <h4 class="modal-title"><t t-esc="state.analyticsDetailModal.title"/></h4>
                                                <div class="zrn_analitics_commercial_table_sub">
                                                    <t t-esc="state.analyticsDetailModal.subtitle"/>
                                                </div>
                                            </div>
                                            <button type="button" class="btn-close" aria-label="Close" t-on-click.stop="closeAnalyticsDetailModal"/>
                                        </div>
                                        <div class="modal-body">
                                            <div class="zrn_analitics_commercial_channel_modal_cards">
                                                <t t-foreach="state.analyticsDetailModal.summary_cards || []" t-as="card" t-key="card.label">
                                                    <div class="zrn_analitics_commercial_coverage_card">
                                                        <span><t t-esc="card.label"/></span>
                                                        <strong><t t-esc="formatDetailCard(state.analyticsDetailModal, card)"/></strong>
                                                    </div>
                                                </t>
                                            </div>

                                            <div class="zrn_analitics_commercial_channel_modal_grid">
                                                <section class="zrn_analitics_hub_panel">
                                                    <div class="zrn_analitics_commercial_panel_head">
                                                        <span>Por canal</span>
                                                        <span>Base analitica</span>
                                                        <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-on-click="(ev) =&gt; this.exportCommercialVisibleContent(ev, { filename: 'zrn_operaciones_modal_detalle_canales' })" aria-label="Exportar detalle por canal"><i class="fa fa-download"/></button>
                                                    </div>
                                                    <div class="zrn_analitics_commercial_table_wrap">
                                                        <table class="zrn_analitics_commercial_table">
                                                            <thead>
                                                                <tr>
                                                                    <th>Canal</th>
                                                                    <th>PDVs</th>
                                                                    <th>Pedidos</th>
                                                                    <th>Unidades</th>
                                                                    <th>Revenue</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <t t-foreach="state.analyticsDetailModal.channel_rows || []" t-as="row" t-key="row.name">
                                                                    <tr class="zrn_analitics_commercial_table_row">
                                                                        <td><strong><t t-esc="row.name"/></strong></td>
                                                                        <td><t t-esc="formatCount(row.pdv_count)"/></td>
                                                                        <td><t t-esc="formatCount(row.order_count)"/></td>
                                                                        <td><t t-esc="formatCount(row.units)"/></td>
                                                                        <td><t t-esc="state.analyticsDetailModal.currency_symbol"/> <t t-esc="formatMoney(row.revenue)"/></td>
                                                                    </tr>
                                                                </t>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </section>

                                                <section class="zrn_analitics_hub_panel">
                                                    <div class="zrn_analitics_commercial_panel_head">
                                                        <span><t t-esc="state.analyticsDetailModal.secondary_title || 'Top PDVs'"/></span>
                                                        <span>Detalle del calculo</span>
                                                        <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-on-click="(ev) =&gt; this.exportCommercialVisibleContent(ev, { filename: 'zrn_operaciones_modal_detalle_secundario' })" aria-label="Exportar detalle secundario"><i class="fa fa-download"/></button>
                                                    </div>
                                                    <div class="zrn_analitics_commercial_table_wrap">
                                                        <table class="zrn_analitics_commercial_table">
                                                            <thead>
                                                                <tr>
                                                                    <th>Nombre</th>
                                                                    <th>Unidades</th>
                                                                    <th>Pedidos</th>
                                                                    <th>Revenue</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <t t-foreach="(state.analyticsDetailModal.secondary_rows || state.analyticsDetailModal.customer_rows || [])" t-as="row" t-key="row.name">
                                                                    <tr class="zrn_analitics_commercial_table_row">
                                                                        <td><strong><t t-esc="row.name"/></strong></td>
                                                                        <td><t t-esc="formatCount(row.units)"/></td>
                                                                        <td><t t-esc="formatCount(row.order_count)"/></td>
                                                                        <td><t t-esc="state.analyticsDetailModal.currency_symbol"/> <t t-esc="formatMoney(row.revenue)"/></td>
                                                                    </tr>
                                                                </t>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </section>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </t>
                </div>
            </div>
        </div>
    </t>
</templates>
