<?xml version='1.0' encoding='UTF-8'?>
<templates xml:space="preserve">
  <t t-name="zrn_analitics.HubOperationsTabTendencias"><t t-if="state.operationsTab === 'tendencias'">
                            <div class="zrn_analitics_operations_top_row">
                                <section class="zrn_analitics_hub_panel">
                                    <div class="zrn_analitics_operations_panel_head">
                                        <span>Tendencias</span>
                                        <span>Variacion del ritmo reciente</span>
                                    </div>
                                    <div class="zrn_analitics_operations_bar_list">
                                        <div class="zrn_analitics_operations_echart zrn_analitics_operations_echart_bar" data-zrn-chart="operations-trends"/>
                                    </div>
                                </section>
                                <section class="zrn_analitics_hub_panel">
                                    <div class="zrn_analitics_operations_panel_head">
                                        <span>Sin venta reciente</span>
                                        <span>Mas de 14 dias sin movimiento</span>
                                    </div>
                                    <div class="zrn_analitics_operations_table_wrap">
                                        <div class="o_list_renderer o_list_view table-responsive">
                                            <table class="o_list_table table table-sm table-hover position-relative mb-0 table-striped">
                                                <thead>
                                                    <tr>
                                                        <th>Producto</th>
                                                        <th class="text-end">Dias sin venta</th>
                                                        <th class="text-end">Revenue</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr t-foreach="operationsPayload.missing_recent_sales" t-as="row" t-key="row.id" t-on-click="() =&gt; this.openOperationsProduct(row)" style="cursor: pointer;">
                                                        <td><strong><t t-esc="row.name"/></strong></td>
                                                        <td class="text-end"><t t-esc="formatCount(row.days_since_last)"/></td>
                                                        <td class="text-end"><t t-esc="operationsPayload.summary.currency_symbol"/> <t t-esc="formatMoney(row.revenue)"/></td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </section>
                            </div>
                            <section class="zrn_analitics_hub_panel">
                                <div class="zrn_analitics_operations_panel_head">
                                    <span>Detalle de tendencia</span>
                                    <span>Click para abrir producto</span>
                                </div>
                                <div class="zrn_analitics_operations_table_wrap">
                                    <div class="o_list_renderer o_list_view table-responsive">
                                        <table class="o_list_table table table-sm table-hover position-relative mb-0 table-striped">
                                            <thead>
                                                <tr>
                                                    <th t-on-click="() =&gt; this.toggleSort('operations_trends', 'name')" class="o_column_sortable" style="cursor: pointer;">Producto</th>
                                                    <th class="text-center">ABC</th>
                                                    <th class="text-center">Rotacion</th>
                                                    <th t-on-click="() =&gt; this.toggleSort('operations_trends', 'trend_pct')" class="o_column_sortable text-end" style="cursor: pointer;">Trend %</th>
                                                    <th t-on-click="() =&gt; this.toggleSort('operations_trends', 'revenue')" class="o_column_sortable text-end" style="cursor: pointer;">Revenue</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr t-foreach="sortedOperationsTrends" t-as="row" t-key="row.id" t-on-click="() =&gt; this.openOperationsProduct(row)" style="cursor: pointer;">
                                                    <td><strong><t t-esc="row.name"/></strong></td>
                                                    <td class="text-center"><t t-esc="row.abc_class"/></td>
                                                    <td class="text-center"><t t-esc="row.rotation_key"/></td>
                                                    <td class="text-end"><t t-esc="formatPercent(row.trend_pct)"/></td>
                                                    <td class="text-end"><t t-esc="operationsPayload.summary.currency_symbol"/> <t t-esc="formatMoney(row.revenue)"/></td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </section>
                        </t>

                        </t>
</templates>
