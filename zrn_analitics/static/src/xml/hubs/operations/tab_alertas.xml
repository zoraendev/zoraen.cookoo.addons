<?xml version='1.0' encoding='UTF-8'?>
<templates xml:space="preserve">
  <t t-name="zrn_analitics.HubOperationsTabAlertas"><t t-if="state.operationsTab === 'alertas'">
                            <div class="zrn_analitics_operations_bottom_grid">
                                <section class="zrn_analitics_hub_panel">
                                    <div class="zrn_analitics_operations_panel_head">
                                        <span>Alertas automaticas</span>
                                        <span>Reglas del pipeline</span>
                                    </div>
                                    <div class="zrn_analitics_operations_coverage_notes">
                                        <t t-foreach="operationsPayload.alerts" t-as="alert" t-key="alert.title">
                                            <div class="zrn_analitics_operations_coverage_note_row">
                                                <strong><t t-esc="alert.title"/></strong>
                                                <span><t t-esc="alert.detail"/></span>
                                            </div>
                                        </t>
                                    </div>
                                </section>
                                <section class="zrn_analitics_hub_panel">
                                    <div class="zrn_analitics_operations_panel_head">
                                        <span>Growers y decliners</span>
                                        <span>Lectura accionable</span>
                                    </div>
                                    <div class="zrn_analitics_operations_coverage_notes">
                                        <div class="zrn_analitics_operations_coverage_note_row">
                                            <strong>Growers</strong>
                                            <span><t t-esc="formatCount(operationsPayload.growers.length)"/> SKUs con tendencia positiva.</span>
                                        </div>
                                        <div class="zrn_analitics_operations_coverage_note_row">
                                            <strong>Decliners</strong>
                                            <span><t t-esc="formatCount(operationsPayload.decliners.length)"/> SKUs con tendencia negativa.</span>
                                        </div>
                                        <div class="zrn_analitics_operations_coverage_note_row">
                                            <strong>Sin venta reciente</strong>
                                            <span><t t-esc="formatCount(operationsPayload.missing_recent_sales.length)"/> SKUs con mas de 14 dias sin movimiento.</span>
                                        </div>
                                    </div>
                                </section>
                            </div>
                        </t>
                    </t>
</templates>
