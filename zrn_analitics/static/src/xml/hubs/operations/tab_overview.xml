<?xml version='1.0' encoding='UTF-8'?>
<templates xml:space="preserve">
  <t t-name="zrn_analitics.HubOperationsTabOverview"><t t-if="state.operationsTab === 'overview'">
                            <div class="zrn_analitics_operations_top_row">
                                <section class="zrn_analitics_hub_panel zrn_analitics_operations_panel_main">
                                    <div class="zrn_analitics_operations_panel_head">
                                        <span>Demanda mensual</span>
                                        <span>Unidades proyectadas por mes</span>
                                        <div class="zrn_analitics_commercial_panel_actions">
                                            <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-on-click="() =&gt; this.setOperationsTab('demanda')" aria-label="Ver demanda"><i class="fa fa-arrow-right"/></button>
                                            <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-att-class="getCommercialPanelView('operations_overview_monthly') === 'chart' ? 'is-active' : ''" t-on-click="() =&gt; this.setCommercialPanelView('operations_overview_monthly', 'chart')" aria-label="Ver grafica"><i class="fa fa-bar-chart"/></button>
                                            <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-on-click="(ev) =&gt; this.exportCommercialVisibleContent(ev, { chartKey: 'operations-overview-monthly', filename: 'zrn_operaciones_demanda_mensual' })" aria-label="Exportar demanda mensual"><i class="fa fa-download"/></button>
                                            <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-att-class="getCommercialPanelView('operations_overview_monthly') === 'table' ? 'is-active' : ''" t-on-click="() =&gt; this.setCommercialPanelView('operations_overview_monthly', 'table')" aria-label="Ver tabla"><i class="fa fa-table"/></button>
                                        </div>
                                    </div>
                                    <div t-if="getCommercialPanelView('operations_overview_monthly') === 'chart'" class="zrn_analitics_operations_line_chart">
                                        <t t-if="hasOperationsMonthlySeries and hasEchartsLibrary">
                                            <div class="zrn_analitics_operations_echart" data-zrn-chart="operations-overview-monthly"/>
                                        </t>
                                        <t t-else="">
                                            <div class="zrn_analitics_operations_chart_empty">Sin demanda mensual para graficar.</div>
                                        </t>
                                    </div>
                                    <div t-if="getCommercialPanelView('operations_overview_monthly') === 'table'" class="zrn_analitics_operations_table_wrap">
                                        <div class="o_list_renderer o_list_view table-responsive">
                                            <table class="o_list_table table table-sm table-hover position-relative mb-0 table-striped">
                                                <thead>
                                                    <tr>
                                                        <th>Mes</th>
                                                        <th class="text-end">Unidades</th>
                                                        <th class="text-end">Proyectado</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr t-foreach="operationsPayload.monthly_demand_series" t-as="row" t-key="row.label">
                                                        <td><strong><t t-esc="row.label"/></strong></td>
                                                        <td class="text-end"><t t-esc="formatCount(row.units || 0)"/></td>
                                                        <td class="text-end"><t t-esc="formatCount(row.projected_units || row.units || 0)"/></td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </section>

                                <section class="zrn_analitics_hub_panel zrn_analitics_operations_panel_side">
                                    <div class="zrn_analitics_operations_panel_head">
                                        <span>Mix por marca</span>
                                        <span>Participacion de unidades</span>
                                        <div class="zrn_analitics_commercial_panel_actions">
                                            <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-on-click="() =&gt; this.setOperationsTab('portafolio')" aria-label="Ver portafolio"><i class="fa fa-arrow-right"/></button>
                                            <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-att-class="getCommercialPanelView('operations_brand_mix') === 'chart' ? 'is-active' : ''" t-on-click="() =&gt; this.setCommercialPanelView('operations_brand_mix', 'chart')" aria-label="Ver grafica"><i class="fa fa-pie-chart"/></button>
                                            <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-on-click="(ev) =&gt; this.exportCommercialVisibleContent(ev, { chartKey: 'operations-overview-brand-mix', filename: 'zrn_operaciones_mix_marca' })" aria-label="Exportar mix por marca"><i class="fa fa-download"/></button>
                                            <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-att-class="getCommercialPanelView('operations_brand_mix') === 'table' ? 'is-active' : ''" t-on-click="() =&gt; this.setCommercialPanelView('operations_brand_mix', 'table')" aria-label="Ver tabla"><i class="fa fa-table"/></button>
                                        </div>
                                    </div>
                                    <div t-if="getCommercialPanelView('operations_brand_mix') === 'chart'" class="zrn_analitics_operations_donut_wrap">
                                        <t t-if="hasOperationsBrandMix and hasEchartsLibrary">
                                            <div class="zrn_analitics_operations_echart zrn_analitics_operations_echart_donut" data-zrn-chart="operations-overview-brand-mix"/>
                                        </t>
                                        <t t-else="">
                                            <div class="zrn_analitics_operations_chart_empty">Sin mix por marca para mostrar.</div>
                                        </t>
                                    </div>
                                    <div t-if="getCommercialPanelView('operations_brand_mix') === 'table'" class="zrn_analitics_operations_table_wrap">
                                        <div class="o_list_renderer o_list_view table-responsive">
                                            <table class="o_list_table table table-sm table-hover position-relative mb-0 table-striped">
                                                <thead>
                                                    <tr>
                                                        <th>Marca</th>
                                                        <th class="text-end">Unidades</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr t-foreach="operationsPayload.brand_units_mix" t-as="row" t-key="row.name">
                                                        <td><strong><t t-esc="row.name"/></strong></td>
                                                        <td class="text-end"><t t-esc="formatCount(row.value || 0)"/></td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </section>
                            </div>

                            <div class="zrn_analitics_operations_bottom_grid">
                                <section class="zrn_analitics_hub_panel">
                                    <div class="zrn_analitics_operations_panel_head">
                                        <span>Distribucion ABC</span>
                                        <span>SKUs por clase</span>
                                        <div class="zrn_analitics_commercial_panel_actions">
                                            <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-on-click="() =&gt; this.setOperationsTab('abc')" aria-label="Ver rotación y ABC"><i class="fa fa-arrow-right"/></button>
                                            <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-att-class="getCommercialPanelView('operations_overview_abc') === 'chart' ? 'is-active' : ''" t-on-click="() =&gt; this.setCommercialPanelView('operations_overview_abc', 'chart')" aria-label="Ver gráfica"><i class="fa fa-bar-chart"/></button>
                                            <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-on-click="(ev) =&gt; this.exportCommercialVisibleContent(ev, { chartKey: 'operations-overview-abc', filename: 'zrn_operaciones_distribucion_abc' })" aria-label="Exportar distribución ABC"><i class="fa fa-download"/></button>
                                            <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-att-class="getCommercialPanelView('operations_overview_abc') === 'table' ? 'is-active' : ''" t-on-click="() =&gt; this.setCommercialPanelView('operations_overview_abc', 'table')" aria-label="Ver tabla"><i class="fa fa-table"/></button>
                                        </div>
                                    </div>
                                    <div t-if="getCommercialPanelView('operations_overview_abc') === 'chart'" class="zrn_analitics_operations_bar_list">
                                        <t t-if="hasEchartsLibrary">
                                            <div class="zrn_analitics_operations_echart zrn_analitics_operations_echart_bar" data-zrn-chart="operations-overview-abc"/>
                                        </t>
                                        <t t-else="">
                                            <div class="zrn_analitics_operations_chart_empty">Libreria ECharts no disponible.</div>
                                        </t>
                                    </div>
                                    <div t-if="getCommercialPanelView('operations_overview_abc') === 'table'" class="zrn_analitics_operations_table_wrap">
                                        <div class="o_list_renderer o_list_view table-responsive">
                                            <table class="o_list_table table table-sm table-hover position-relative mb-0 table-striped">
                                                <thead><tr><th>Clase</th><th class="text-end">SKUs</th></tr></thead>
                                                <tbody>
                                                    <tr t-foreach="operationsPayload.abc_distribution" t-as="row" t-key="row.label">
                                                        <td><strong><t t-esc="row.label"/></strong></td>
                                                        <td class="text-end"><t t-esc="formatCount(row.value || 0)"/></td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </section>

                                <section class="zrn_analitics_hub_panel">
                                    <div class="zrn_analitics_operations_panel_head">
                                        <span>Distribucion de rotacion</span>
                                        <span>Frecuencia de venta</span>
                                        <div class="zrn_analitics_commercial_panel_actions">
                                            <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-on-click="() =&gt; this.setOperationsTab('abc')" aria-label="Ver rotación y ABC"><i class="fa fa-arrow-right"/></button>
                                            <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-att-class="getCommercialPanelView('operations_overview_rotation') === 'chart' ? 'is-active' : ''" t-on-click="() =&gt; this.setCommercialPanelView('operations_overview_rotation', 'chart')" aria-label="Ver gráfica"><i class="fa fa-bar-chart"/></button>
                                            <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-on-click="(ev) =&gt; this.exportCommercialVisibleContent(ev, { chartKey: 'operations-overview-rotation', filename: 'zrn_operaciones_distribucion_rotacion' })" aria-label="Exportar distribución de rotación"><i class="fa fa-download"/></button>
                                            <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-att-class="getCommercialPanelView('operations_overview_rotation') === 'table' ? 'is-active' : ''" t-on-click="() =&gt; this.setCommercialPanelView('operations_overview_rotation', 'table')" aria-label="Ver tabla"><i class="fa fa-table"/></button>
                                        </div>
                                    </div>
                                    <div t-if="getCommercialPanelView('operations_overview_rotation') === 'chart'" class="zrn_analitics_operations_bar_list">
                                        <t t-if="hasEchartsLibrary">
                                            <div class="zrn_analitics_operations_echart zrn_analitics_operations_echart_bar" data-zrn-chart="operations-overview-rotation"/>
                                        </t>
                                        <t t-else="">
                                            <div class="zrn_analitics_operations_chart_empty">Libreria ECharts no disponible.</div>
                                        </t>
                                    </div>
                                    <div t-if="getCommercialPanelView('operations_overview_rotation') === 'table'" class="zrn_analitics_operations_table_wrap">
                                        <div class="o_list_renderer o_list_view table-responsive">
                                            <table class="o_list_table table table-sm table-hover position-relative mb-0 table-striped">
                                                <thead><tr><th>Rotación</th><th class="text-end">SKUs</th></tr></thead>
                                                <tbody>
                                                    <tr t-foreach="operationsPayload.rotation_distribution" t-as="row" t-key="row.label">
                                                        <td><strong><t t-esc="row.label"/></strong></td>
                                                        <td class="text-end"><t t-esc="formatCount(row.value || 0)"/></td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </section>
                            </div>

                            <section class="zrn_analitics_hub_panel">
                                <div class="zrn_analitics_operations_panel_head">
                                    <span>Top SKUs</span>
                                    <span>Ordenado por unidades vendidas</span>
                                    <div class="zrn_analitics_commercial_panel_actions">
                                        <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-on-click="() =&gt; this.setOperationsTab('abc')" aria-label="Ver rotación y ABC"><i class="fa fa-arrow-right"/></button>
                                        <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-att-class="getCommercialPanelView('operations_top_skus') === 'chart' ? 'is-active' : ''" t-on-click="() =&gt; this.setCommercialPanelView('operations_top_skus', 'chart')" aria-label="Ver gráfica"><i class="fa fa-bar-chart"/></button>
                                        <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-on-click="() =&gt; this.toggleAnalyticsChartConfig('operations_top_skus')" aria-label="Configurar gráfica"><i class="fa fa-sliders"/></button>
                                        <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-on-click="(ev) =&gt; this.exportCommercialVisibleContent(ev, { chartKey: 'analytics-panel-operations_top_skus', filename: 'zrn_operaciones_top_skus' })" aria-label="Exportar top SKUs"><i class="fa fa-download"/></button>
                                        <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-att-class="getCommercialPanelView('operations_top_skus') === 'table' ? 'is-active' : ''" t-on-click="() =&gt; this.setCommercialPanelView('operations_top_skus', 'table')" aria-label="Ver tabla"><i class="fa fa-table"/></button>
                                    </div>
                                </div>
                                <t t-if="getCommercialPanelView('operations_top_skus') === 'chart'">
                                    <div class="zrn_analitics_operations_bar_list">
                                        <div class="zrn_analitics_operations_echart zrn_analitics_operations_echart_bar" data-zrn-chart="analytics-panel-operations_top_skus"/>
                                    </div>
                                </t>
                                <t t-if="getCommercialPanelView('operations_top_skus') === 'table'">
                                <div class="zrn_analitics_operations_table_wrap">
                                    <div class="o_list_renderer o_list_view table-responsive">
                                        <table class="o_list_table table table-sm table-hover position-relative mb-0 table-striped">
                                            <thead>
                                                <tr>
                                                    <th t-on-click="() =&gt; this.toggleSort('operations_top_skus', 'name')" class="o_column_sortable" style="cursor: pointer;">Producto</th>
                                                    <th t-on-click="() =&gt; this.toggleSort('operations_top_skus', 'brand_name')" class="o_column_sortable" style="cursor: pointer;">Marca</th>
                                                    <th t-on-click="() =&gt; this.toggleSort('operations_top_skus', 'abc_class')" class="o_column_sortable text-center" style="cursor: pointer;">ABC</th>
                                                    <th t-on-click="() =&gt; this.toggleSort('operations_top_skus', 'rotation_key')" class="o_column_sortable text-center" style="cursor: pointer;">Rotacion</th>
                                                    <th t-on-click="() =&gt; this.toggleSort('operations_top_skus', 'units')" class="o_column_sortable text-end" style="cursor: pointer;">Unidades</th>
                                                    <th t-on-click="() =&gt; this.toggleSort('operations_top_skus', 'revenue')" class="o_column_sortable text-end" style="cursor: pointer;">Revenue</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr t-foreach="sortedOperationsTopSkus" t-as="row" t-key="row.id" t-on-click="() =&gt; this.openOperationsProduct(row)" style="cursor: pointer;">
                                                    <td><strong><t t-esc="row.name"/></strong></td>
                                                    <td><t t-esc="row.brand_name"/></td>
                                                    <td class="text-center"><t t-esc="row.abc_class"/></td>
                                                    <td class="text-center"><t t-esc="row.rotation_key"/></td>
                                                    <td class="text-end"><t t-esc="formatCount(row.units)"/></td>
                                                    <td class="text-end"><t t-esc="operationsPayload.summary.currency_symbol"/> <t t-esc="formatMoney(row.revenue)"/></td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                                </t>
                            </section>
                        </t>

                        </t>
</templates>
