<?xml version='1.0' encoding='UTF-8'?>
<templates xml:space="preserve">
  <t t-name="zrn_analitics.HubOperationsTabAbc"><t t-if="state.operationsTab === 'abc'">
                            <div class="zrn_analitics_operations_bottom_grid">
                                <section class="zrn_analitics_hub_panel">
                                    <div class="zrn_analitics_operations_panel_head">
                                        <span>Curva ABC</span>
                                        <span>Concentracion por SKU</span>
                                    </div>
                                    <div class="zrn_analitics_operations_bar_list">
                                        <div class="zrn_analitics_operations_echart zrn_analitics_operations_echart_bar" data-zrn-chart="operations-overview-abc"/>
                                    </div>
                                </section>
                                <section class="zrn_analitics_hub_panel">
                                    <div class="zrn_analitics_operations_panel_head">
                                        <span>Rotacion</span>
                                        <span>Frecuencia de venta</span>
                                    </div>
                                    <div class="zrn_analitics_operations_bar_list">
                                        <div class="zrn_analitics_operations_echart zrn_analitics_operations_echart_bar" data-zrn-chart="operations-overview-rotation"/>
                                    </div>
                                </section>
                            </div>
                            <section class="zrn_analitics_hub_panel">
                                <div class="zrn_analitics_operations_panel_head">
                                    <span>Detalle ABC y rotacion</span>
                                    <span>Click para abrir producto</span>
                                </div>
                                <div class="zrn_analitics_operations_table_wrap">
                                    <div class="o_list_renderer o_list_view table-responsive">
                                        <table class="o_list_table table table-sm table-hover position-relative mb-0 table-striped">
                                            <thead>
                                                <tr>
                                                    <th t-on-click="() =&gt; this.toggleSort('operations_abc', 'name')" class="o_column_sortable" style="cursor: pointer;">Producto</th>
                                                    <th class="text-center">ABC</th>
                                                    <th class="text-center">Rotacion</th>
                                                    <th t-on-click="() =&gt; this.toggleSort('operations_abc', 'days_active')" class="o_column_sortable text-end" style="cursor: pointer;">Dias activos</th>
                                                    <th t-on-click="() =&gt; this.toggleSort('operations_abc', 'units')" class="o_column_sortable text-end" style="cursor: pointer;">Unidades</th>
                                                    <th t-on-click="() =&gt; this.toggleSort('operations_abc', 'revenue')" class="o_column_sortable text-end" style="cursor: pointer;">Revenue</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr t-foreach="sortedOperationsAbc" t-as="row" t-key="row.id" t-on-click="() =&gt; this.openOperationsProduct(row)" style="cursor: pointer;">
                                                    <td><strong><t t-esc="row.name"/></strong></td>
                                                    <td class="text-center"><t t-esc="row.abc_class"/></td>
                                                    <td class="text-center"><t t-esc="row.rotation_key"/></td>
                                                    <td class="text-end"><t t-esc="formatCount(row.days_active)"/></td>
                                                    <td class="text-end"><t t-esc="formatCount(row.units)"/></td>
                                                    <td class="text-end"><t t-esc="operationsPayload.summary.currency_symbol"/> <t t-esc="formatMoney(row.revenue)"/></td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </section>
                        </t>

                        </t>
</templates>
