<?xml version='1.0' encoding='UTF-8'?>
<templates xml:space="preserve">
  <t t-name="zrn_analitics.HubPdvTabAlertas"><t t-if="state.pdvTab === 'alertas'">
                            <div class="zrn_analitics_commercial_summary_table_wrap">
                                <table class="table table-sm zrn_analitics_commercial_summary_table mb-0">
                                    <thead>
                                        <tr>
                                            <th>Dormantes</th>
                                            <th>Nuevos</th>
                                            <th>Low sell-through</th>
                                            <th>Total alertas</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td><strong><t t-esc="formatCount(pdvPayload.summary.dormant_count)"/></strong></td>
                                            <td><strong><t t-esc="formatCount(pdvPayload.summary.new_count)"/></strong></td>
                                            <td><strong><t t-esc="formatCount(pdvPayload.summary.low_st_count)"/></strong></td>
                                            <td><strong><t t-esc="formatCount(pdvPayload.summary.alert_count)"/></strong></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <section class="zrn_analitics_hub_panel">
                                <div class="zrn_analitics_pdv_panel_head">
                                    <span>Alertas por PDV</span>
                                    <span>Click para drill-down</span>
                                    <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-on-click="(ev) =&gt; this.exportCommercialVisibleContent(ev, { filename: 'zrn_pdv_alertas' })" aria-label="Exportar alertas por PDV"><i class="fa fa-download"/></button>
                                </div>
                                <div class="zrn_analitics_pdv_table_wrap">
                                    <table class="zrn_analitics_pdv_table">
                                        <thead>
                                            <tr>
                                                <th t-on-click="() =&gt; this.toggleSort('pdv_alerts', 'name_short')">PDV</th>
                                                <th t-on-click="() =&gt; this.toggleSort('pdv_alerts', 'channel')">Canal</th>
                                                <th>Alertas</th>
                                                <th t-on-click="() =&gt; this.toggleSort('pdv_alerts', 'days_since_last')" class="text-end">Recencia</th>
                                                <th t-on-click="() =&gt; this.toggleSort('pdv_alerts', 'rev')" class="text-end">Revenue</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="sortedPdvAlerts" t-as="row" t-key="'alert_' + row.partner_id">
                                                <tr class="zrn_analitics_pdv_row_clickable" t-on-click="() =&gt; this.openPdvRow(row)">
                                                    <td><strong><t t-esc="row.name_short"/></strong></td>
                                                    <td><t t-esc="row.channel"/></td>
                                                    <td>
                                                        <div class="zrn_analitics_pdv_alert_tags">
                                                            <t t-foreach="row.alerts" t-as="alert" t-key="alert.type">
                                                                <span class="zrn_analitics_pdv_alert_tag" t-att-class="'is-' + alert.sev"><t t-esc="alert.msg"/></span>
                                                            </t>
                                                        </div>
                                                    </td>
                                                    <td class="text-end"><t t-esc="row.days_since_last"/> d</td>
                                                    <td class="text-end"><t t-esc="pdvPayload.summary.currency_symbol"/> <t t-esc="formatMoney(row.rev)"/></td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </section>
                        </t>
                    </t>
</templates>
