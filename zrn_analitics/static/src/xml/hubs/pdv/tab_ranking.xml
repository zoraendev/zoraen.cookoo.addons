<?xml version='1.0' encoding='UTF-8'?>
<templates xml:space="preserve">
  <t t-name="zrn_analitics.HubPdvTabRanking"><t t-if="state.pdvTab === 'ranking'">
                            <section class="zrn_analitics_hub_panel">
                                <div class="zrn_analitics_pdv_panel_head">
                                    <span>Ranking de PDVs</span>
                                    <span><t t-esc="formatCount(pdvPayload.ranking_rows.length)"/> PDVs filtrados</span>
                                </div>
                                <div class="zrn_analitics_pdv_table_wrap">
                                    <table class="zrn_analitics_pdv_table">
                                        <thead>
                                            <tr>
                                                <th t-on-click="() =&gt; this.toggleSort('pdv_ranking', 'rank')">#</th>
                                                <th t-on-click="() =&gt; this.toggleSort('pdv_ranking', 'name_short')">PDV</th>
                                                <th t-on-click="() =&gt; this.toggleSort('pdv_ranking', 'channel')">Canal</th>
                                                <th t-on-click="() =&gt; this.toggleSort('pdv_ranking', 'subchain')">Subcanal</th>
                                                <th t-on-click="() =&gt; this.toggleSort('pdv_ranking', 'rev')" class="text-end">Revenue</th>
                                                <th t-on-click="() =&gt; this.toggleSort('pdv_ranking', 'invoices')" class="text-end">Pedidos</th>
                                                <th t-on-click="() =&gt; this.toggleSort('pdv_ranking', 'avg_ticket')" class="text-end">Ticket</th>
                                                <th t-on-click="() =&gt; this.toggleSort('pdv_ranking', 'days_since_last')" class="text-end">Recencia</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="sortedPdvRanking" t-as="row" t-key="row.partner_id">
                                                <tr class="zrn_analitics_pdv_row_clickable" t-on-click="() =&gt; this.openPdvRow(row)">
                                                    <td><t t-esc="row.rank"/></td>
                                                    <td>
                                                        <strong><t t-esc="row.name_short"/></strong>
                                                        <div class="zrn_analitics_pdv_table_sub"><t t-esc="row.client_full"/></div>
                                                    </td>
                                                    <td><t t-esc="row.channel"/></td>
                                                    <td><t t-esc="row.subchain"/></td>
                                                    <td class="text-end"><t t-esc="pdvPayload.summary.currency_symbol"/> <t t-esc="formatMoney(row.rev)"/></td>
                                                    <td class="text-end"><t t-esc="formatCount(row.invoices)"/></td>
                                                    <td class="text-end"><t t-esc="pdvPayload.summary.currency_symbol"/> <t t-esc="formatMoney(row.avg_ticket)"/></td>
                                                    <td class="text-end"><t t-esc="row.days_since_last"/> d</td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </section>
                        </t>

                        </t>
</templates>
