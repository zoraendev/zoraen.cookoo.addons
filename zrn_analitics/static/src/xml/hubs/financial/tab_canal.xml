<?xml version='1.0' encoding='UTF-8'?>
<templates xml:space="preserve">
  <t t-name="zrn_analitics.HubFinancialTabCanal"><t t-if="state.financialTab === 'canal'">
                            <div class="zrn_analitics_financial_top_row">
                                <section class="zrn_analitics_hub_panel">
                                    <div class="zrn_analitics_financial_panel_head">
                                        <span>Margen % por canal</span>
                                        <span>Comparativo filtrado</span>
                                    </div>
                                    <div class="zrn_analitics_financial_bar_list">
                                        <t t-if="sortedFinancialChannels.length &amp;&amp; hasEchartsLibrary">
                                            <div class="zrn_analitics_financial_echart zrn_analitics_financial_echart_bar" data-zrn-chart="financial-channel-detail"/>
                                        </t>
                                        <t t-else="">
                                            <div class="zrn_analitics_financial_chart_empty">Sin canales para mostrar.</div>
                                        </t>
                                    </div>
                                </section>
                            </div>

                            <section class="zrn_analitics_hub_panel">
                                <div class="zrn_analitics_financial_panel_head">
                                    <span>Detalle por canal</span>
                                    <span>Click en la fila para abrir detalle</span>
                                </div>
                                <div class="zrn_analitics_financial_table_wrap">
                                    <div class="o_list_renderer o_list_view table-responsive">
                                        <table class="o_list_table table table-sm table-hover position-relative mb-0 table-striped">
                                            <thead>
                                                <tr>
                                                    <th t-on-click="() =&gt; this.toggleSort('financial_channels', 'name')" class="o_column_sortable">Canal</th>
                                                    <th t-on-click="() =&gt; this.toggleSort('financial_channels', 'product_count')" class="o_column_sortable text-end">Productos</th>
                                                    <th t-on-click="() =&gt; this.toggleSort('financial_channels', 'revenue')" class="o_column_sortable text-end">Revenue</th>
                                                    <th t-on-click="() =&gt; this.toggleSort('financial_channels', 'matched_revenue')" class="o_column_sortable text-end">Rev. matcheado</th>
                                                    <th t-on-click="() =&gt; this.toggleSort('financial_channels', 'cost')" class="o_column_sortable text-end">Costo</th>
                                                    <th t-on-click="() =&gt; this.toggleSort('financial_channels', 'margin')" class="o_column_sortable text-end">Margen</th>
                                                    <th t-on-click="() =&gt; this.toggleSort('financial_channels', 'margin_pct')" class="o_column_sortable text-end">Margen %</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="sortedFinancialChannels" t-as="row" t-key="row.key">
                                                    <tr t-on-click="() =&gt; this.openFinancialChannel(row)" style="cursor: pointer;">
                                                        <td><strong><t t-esc="row.name"/></strong></td>
                                                        <td class="text-end"><t t-esc="formatCount(row.product_count)"/></td>
                                                        <td class="text-end"><t t-esc="financialPayload.summary.currency_symbol"/> <t t-esc="formatMoney(row.revenue)"/></td>
                                                        <td class="text-end"><t t-esc="financialPayload.summary.currency_symbol"/> <t t-esc="formatMoney(row.matched_revenue)"/></td>
                                                        <td class="text-end"><t t-esc="financialPayload.summary.currency_symbol"/> <t t-esc="formatMoney(row.cost)"/></td>
                                                        <td class="text-end"><t t-esc="financialPayload.summary.currency_symbol"/> <t t-esc="formatMoney(row.margin)"/></td>
                                                        <td class="text-end"><t t-esc="formatPercent(row.margin_pct)"/></td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </section>

                            <section class="zrn_analitics_hub_panel">
                                <div class="zrn_analitics_financial_panel_head">
                                    <span>Producto × canal</span>
                                    <span>Top 30 por margen</span>
                                </div>
                                <div class="zrn_analitics_financial_table_wrap">
                                    <div class="o_list_renderer o_list_view table-responsive">
                                        <table class="o_list_table table table-sm position-relative mb-0 table-striped">
                                            <thead>
                                                <tr>
                                                    <th t-on-click="() =&gt; this.toggleSort('financial_product_channel', 'channel')" class="o_column_sortable">Canal</th>
                                                    <th t-on-click="() =&gt; this.toggleSort('financial_product_channel', 'product_name')" class="o_column_sortable">Producto</th>
                                                    <th t-on-click="() =&gt; this.toggleSort('financial_product_channel', 'brand_name')" class="o_column_sortable">Marca</th>
                                                    <th t-on-click="() =&gt; this.toggleSort('financial_product_channel', 'revenue')" class="o_column_sortable text-end">Revenue</th>
                                                    <th t-on-click="() =&gt; this.toggleSort('financial_product_channel', 'margin')" class="o_column_sortable text-end">Margen</th>
                                                    <th t-on-click="() =&gt; this.toggleSort('financial_product_channel', 'margin_pct')" class="o_column_sortable text-end">Margen %</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="sortedFinancialProductChannel" t-as="row" t-key="row.key">
                                                    <tr>
                                                        <td><strong><t t-esc="row.channel"/></strong></td>
                                                        <td><t t-esc="row.product_name"/></td>
                                                        <td><t t-esc="row.brand_name"/></td>
                                                        <td class="text-end"><t t-esc="financialPayload.summary.currency_symbol"/> <t t-esc="formatMoney(row.revenue)"/></td>
                                                        <td class="text-end"><t t-esc="financialPayload.summary.currency_symbol"/> <t t-esc="formatMoney(row.margin)"/></td>
                                                        <td class="text-end"><t t-esc="formatPercent(row.margin_pct)"/></td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </section>
                        </t>

                        </t>
</templates>
