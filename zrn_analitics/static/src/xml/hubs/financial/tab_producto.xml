<?xml version='1.0' encoding='UTF-8'?>
<templates xml:space="preserve">
  <t t-name="zrn_analitics.HubFinancialTabProducto"><t t-if="state.financialTab === 'producto'">
                            <div class="zrn_analitics_financial_top_row">
                                <section class="zrn_analitics_hub_panel">
                                    <div class="zrn_analitics_financial_panel_head">
                                        <span>Margen por producto</span>
                                        <span>Top 10 por contribución</span>
                                        <div class="zrn_analitics_commercial_panel_actions">
                                            <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-on-click="(ev) =&gt; this.exportCommercialVisibleContent(ev, { chartKey: 'financial-product-margin', filename: 'zrn_financiero_margen_producto' })" aria-label="Exportar margen por producto"><i class="fa fa-download"/></button>
                                        </div>
                                    </div>
                                    <div class="zrn_analitics_financial_bar_list">
                                        <t t-if="sortedFinancialProducts.length &amp;&amp; hasEchartsLibrary">
                                            <div class="zrn_analitics_financial_echart zrn_analitics_financial_echart_bar" data-zrn-chart="financial-product-margin"/>
                                        </t>
                                        <t t-else="">
                                            <div class="zrn_analitics_financial_chart_empty">Sin productos para mostrar.</div>
                                        </t>
                                    </div>
                                </section>

                                <section class="zrn_analitics_hub_panel">
                                    <div class="zrn_analitics_financial_panel_head">
                                        <span>Margen % por producto</span>
                                        <span>Top 10 con costo matcheado</span>
                                        <div class="zrn_analitics_commercial_panel_actions">
                                            <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-on-click="(ev) =&gt; this.exportCommercialVisibleContent(ev, { chartKey: 'financial-product-margin-pct', filename: 'zrn_financiero_margen_pct_producto' })" aria-label="Exportar margen porcentual por producto"><i class="fa fa-download"/></button>
                                        </div>
                                    </div>
                                    <div class="zrn_analitics_financial_bar_list">
                                        <t t-if="sortedFinancialProducts.length &amp;&amp; hasEchartsLibrary">
                                            <div class="zrn_analitics_financial_echart zrn_analitics_financial_echart_bar" data-zrn-chart="financial-product-margin-pct"/>
                                        </t>
                                        <t t-else="">
                                            <div class="zrn_analitics_financial_chart_empty">Sin margen porcentual para mostrar.</div>
                                        </t>
                                    </div>
                                </section>
                            </div>

                            <section class="zrn_analitics_hub_panel">
                                <div class="zrn_analitics_financial_panel_head">
                                    <span>Ranking de productos</span>
                                    <span>Click en la fila para abrir detalle</span>
                                    <div class="zrn_analitics_commercial_panel_actions">
                                        <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-on-click="() =&gt; this.setCommercialPanelView('financial_products', 'chart')" aria-label="Ver gráfica"><i class="fa fa-bar-chart"/></button>
                                        <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-on-click="() =&gt; this.toggleAnalyticsChartConfig('financial_products')" aria-label="Configurar gráfica"><i class="fa fa-sliders"/></button>
                                        <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-on-click="(ev) =&gt; this.exportCommercialVisibleContent(ev, { chartKey: 'analytics-panel-financial_products', filename: 'zrn_financiero_ranking_productos' })" aria-label="Exportar ranking de productos"><i class="fa fa-download"/></button>
                                        <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-on-click="() =&gt; this.setCommercialPanelView('financial_products', 'table')" aria-label="Ver tabla"><i class="fa fa-table"/></button>
                                    </div>
                                </div>
                                <t t-if="getCommercialPanelView('financial_products') === 'chart'">
                                    <div class="zrn_analitics_financial_bar_list">
                                        <div class="zrn_analitics_financial_echart zrn_analitics_financial_echart_bar" data-zrn-chart="analytics-panel-financial_products"/>
                                    </div>
                                </t>
                                <t t-if="getCommercialPanelView('financial_products') === 'table'">
                                <div class="zrn_analitics_financial_table_wrap">
                                    <div class="o_list_renderer o_list_view table-responsive">
                                        <table class="o_list_table table table-sm table-hover position-relative mb-0 table-striped">
                                            <thead>
                                                <tr>
                                                    <th t-on-click="() =&gt; this.toggleSort('financial_products', 'name')" class="o_column_sortable">Producto</th>
                                                    <th t-on-click="() =&gt; this.toggleSort('financial_products', 'brand_name')" class="o_column_sortable">Marca</th>
                                                    <th t-on-click="() =&gt; this.toggleSort('financial_products', 'channel_count')" class="o_column_sortable text-end">Canales</th>
                                                    <th t-on-click="() =&gt; this.toggleSort('financial_products', 'revenue')" class="o_column_sortable text-end">Revenue</th>
                                                    <th t-on-click="() =&gt; this.toggleSort('financial_products', 'matched_revenue')" class="o_column_sortable text-end">Rev. matcheado</th>
                                                    <th t-on-click="() =&gt; this.toggleSort('financial_products', 'cost')" class="o_column_sortable text-end">Costo</th>
                                                    <th t-on-click="() =&gt; this.toggleSort('financial_products', 'margin')" class="o_column_sortable text-end">Margen</th>
                                                    <th t-on-click="() =&gt; this.toggleSort('financial_products', 'margin_pct')" class="o_column_sortable text-end">Margen %</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="sortedFinancialProducts" t-as="row" t-key="row.id">
                                                    <tr t-on-click="() =&gt; this.openFinancialProduct(row)" style="cursor: pointer;">
                                                        <td><strong><t t-esc="row.name"/></strong></td>
                                                        <td><t t-esc="row.brand_name"/></td>
                                                        <td class="text-end"><t t-esc="formatCount(row.channel_count)"/></td>
                                                        <td class="text-end"><t t-esc="financialPayload.summary.currency_symbol"/> <t t-esc="formatMoney(row.revenue)"/></td>
                                                        <td class="text-end"><t t-esc="financialPayload.summary.currency_symbol"/> <t t-esc="formatMoney(row.matched_revenue)"/></td>
                                                        <td class="text-end"><t t-esc="financialPayload.summary.currency_symbol"/> <t t-esc="formatMoney(row.cost)"/></td>
                                                        <td class="text-end"><t t-esc="financialPayload.summary.currency_symbol"/> <t t-esc="formatMoney(row.margin)"/></td>
                                                        <td class="text-end"><t t-esc="formatPercent(row.margin_pct)"/></td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                                </t>
                            </section>
                        </t>

                        </t>
</templates>
