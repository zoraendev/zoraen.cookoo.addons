<?xml version='1.0' encoding='UTF-8'?>
<templates xml:space="preserve">
  <t t-name="zrn_analitics.HubCommercialTabPortafolio"><t t-if="!state.commercialLoading &amp;&amp; state.commercialTab === 'portafolio'">
                <t t-call="zrn_analitics.HubCommercialFilters"/>
                <div class="zrn_analitics_commercial_portfolio">
                    <t t-if="!commercialPortfolio.hasBrands">
                        <div class="zrn_analitics_hub_panel">
                            <div class="zrn_analitics_hub_panel_title">Portafolio</div>
                            <div class="zrn_analitics_hub_panel_text">
                                No hay marcas comerciales creadas en (ZRN) Manejo Comercial para construir esta vista.
                            </div>
                        </div>
                    </t>

                    <t t-if="commercialPortfolio.hasBrands">
                        <div class="zrn_analitics_commercial_portfolio_top">
                            <section class="zrn_analitics_hub_panel">
                                <div class="zrn_analitics_commercial_panel_head">
                                    <span>Ingresos por unidad</span>
                                    <div class="zrn_analitics_commercial_panel_actions">
                                        <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-on-click="() =&gt; this.selectPortfolioUnit(commercialPortfolio.units.length ? commercialPortfolio.units[0].key : '')" aria-label="Ver primera unidad">
                                            <i class="fa fa-arrow-right"/>
                                        </button>
                                        <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-on-click="(ev) =&gt; this.exportCommercialVisibleContent(ev, { chartKey: 'portfolio-units', filename: 'zrn_comercial_ingresos_por_unidad' })" aria-label="Exportar portafolio">
                                            <i class="fa fa-download"/>
                                        </button>
                                    </div>
                                </div>
                                <div class="zrn_analitics_commercial_portfolio_chart">
                                    <t t-if="commercialPortfolio.hasRevenue and hasEchartsLibrary">
                                        <div class="zrn_analitics_commercial_echart zrn_analitics_commercial_echart_bar" data-zrn-chart="portfolio-units"/>
                                    </t>
                                    <t t-elif="commercialPortfolio.hasRevenue">
                                        <div class="zrn_analitics_commercial_chart_empty">Hay datos de portafolio, pero la libreria ECharts aun no esta cargada en assets.</div>
                                    </t>
                                    <t t-else="">
                                        <div class="zrn_analitics_commercial_chart_empty">Sin ventas ligadas a marcas en el periodo.</div>
                                    </t>
                                </div>
                            </section>

                            <section class="zrn_analitics_hub_panel">
                                <div class="zrn_analitics_commercial_panel_head">
                                    <span>Marca comercial dentro de UN</span>
                                    <div class="zrn_analitics_commercial_panel_actions">
                                        <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-on-click="() =&gt; this.setCommercialTab('overview')" aria-label="Volver a overview">
                                            <i class="fa fa-arrow-right"/>
                                        </button>
                                        <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-on-click="(ev) =&gt; this.exportCommercialVisibleContent(ev, { chartKey: 'portfolio-brands', filename: 'zrn_comercial_marcas_por_unidad' })" aria-label="Exportar marcas">
                                            <i class="fa fa-download"/>
                                        </button>
                                    </div>
                                </div>
                                <div class="zrn_analitics_commercial_portfolio_brand_mix">
                                    <t t-if="activePortfolioUnit and activePortfolioUnit.brands.length and commercialPortfolio.hasRevenue and hasEchartsLibrary">
                                        <div class="zrn_analitics_commercial_echart zrn_analitics_commercial_echart_bar" data-zrn-chart="portfolio-brands"/>
                                    </t>
                                    <t t-elif="activePortfolioUnit and activePortfolioUnit.brands.length and commercialPortfolio.hasRevenue">
                                        <div class="zrn_analitics_commercial_chart_empty">Hay marcas con revenue, pero la libreria ECharts aun no esta cargada en assets.</div>
                                    </t>
                                    <t t-else="">
                                        <div class="zrn_analitics_commercial_chart_empty">Sin marcas con revenue asignado para esta unidad.</div>
                                    </t>
                                </div>
                            </section>
                        </div>

                        <section class="zrn_analitics_hub_panel">
                            <div class="zrn_analitics_commercial_panel_head">
                                <span>Drill UN → marca → categoría → SKU</span>
                                <div class="zrn_analitics_commercial_panel_actions">
                                    <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-on-click="() =&gt; this.setCommercialTab('producto')" aria-label="Ver productos">
                                        <i class="fa fa-arrow-right"/>
                                    </button>
                                    <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-on-click="(ev) =&gt; this.exportCommercialVisibleContent(ev, { filename: 'zrn_comercial_drill_portafolio' })" aria-label="Exportar drill">
                                        <i class="fa fa-download"/>
                                    </button>
                                </div>
                            </div>
                            <div class="zrn_analitics_commercial_portfolio_table_wrap">
                                <div class="o_list_renderer o_list_view table-responsive">
                                <table class="o_list_table table table-sm table-hover position-relative mb-0 table-striped">
                                    <thead>
                                        <tr>
                                            <th>Nivel</th>
                                            <th>Revenue</th>
                                            <th>% Mix</th>
                                            <th>Unidades</th>
                                            <th>Líneas fact.</th>
                                            <th>SKUs</th>
                                            <th>Margen Q</th>
                                            <th>Margen %</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="commercialPortfolio.drillRows" t-as="row" t-key="row.key">
                                            <tr t-if="isPortfolioRowVisible(row)" class="zrn_analitics_commercial_portfolio_row" t-att-class="'is-' + row.level" t-on-click="() =&gt; this.onPortfolioRowClick(row)" t-att-style="row.level === 'brand' || row.level === 'line' || row.level === 'sku' ? 'cursor: pointer;' : ''">
                                                <td>
                                                    <div class="zrn_analitics_commercial_portfolio_cell d-flex align-items-center" t-att-class="'is-' + row.level">
                                                        <button t-if="row.level !== 'sku'" type="button" class="btn btn-link p-0 me-1 zrn_analitics_commercial_portfolio_toggle text-decoration-none text-reset" t-on-click.stop="() =&gt; this.togglePortfolioRow(row.key)" style="width: 1.5rem; height: 1.5rem;">
                                                            <t t-esc="isPortfolioRowExpanded(row.key) ? '▾' : '▸'"/>
                                                        </button>
                                                        <span t-if="row.level === 'unit'" class="zrn_analitics_commercial_portfolio_dot rounded-circle me-1" t-att-style="'background:' + row.color + '; width: 8px; height: 8px; display: inline-block;'"/>
                                                        <span><t t-esc="row.label"/></span>
                                                    </div>
                                                </td>
                                                <td><t t-esc="commercialPortfolio.currencySymbol"/> <t t-esc="formatMoney(row.revenue)"/></td>
                                                <td><t t-esc="formatPercent(row.mix_percentage)"/></td>
                                                <td><t t-esc="row.units_sold ? formatCount(row.units_sold) : '—'"/></td>
                                                <td><t t-esc="row.billed_lines ? formatCount(row.billed_lines) : '—'"/></td>
                                                <td><t t-esc="row.sku_count ? formatCount(row.sku_count) : '—'"/></td>
                                                <td><t t-esc="row.margin_amount ? commercialPortfolio.currencySymbol + ' ' + formatMoney(row.margin_amount) : '—'"/></td>
                                                <td><t t-esc="row.margin_amount ? formatPercent(row.margin_pct) : '—'"/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                                </div>
                            </div>
                        </section>

                    </t>
                </div>
            </t>

            </t>
</templates>
