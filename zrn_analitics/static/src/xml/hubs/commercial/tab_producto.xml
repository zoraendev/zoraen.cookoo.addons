<?xml version='1.0' encoding='UTF-8'?>
<templates xml:space="preserve">
  <t t-name="zrn_analitics.HubCommercialTabProducto"><t t-if="!state.commercialLoading &amp;&amp; state.commercialTab === 'producto'">
                <t t-call="zrn_analitics.HubCommercialFilters"/>
                
                <section class="zrn_analitics_hub_panel">
                    <div class="zrn_analitics_commercial_panel_head">
                        <span>Catálogo completo de productos y marcas</span>
                        <div class="zrn_analitics_commercial_panel_actions">
                            <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-att-class="getCommercialPanelView('product_main') === 'chart' ? 'is-active' : ''" t-on-click="() =&gt; this.setCommercialPanelView('product_main', 'chart')" aria-label="Ver gráfica"><i class="fa fa-bar-chart"/></button>
                            <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-on-click="toggleProductChartConfig" aria-label="Configurar gráfica"><i class="fa fa-sliders"/></button>
                            <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-on-click="(ev) =&gt; this.exportCommercialVisibleContent(ev, { chartKey: 'product-chart', filename: 'zrn_comercial_productos' })" aria-label="Exportar productos"><i class="fa fa-download"/></button>
                            <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-att-class="getCommercialPanelView('product_main') === 'table' ? 'is-active' : ''" t-on-click="() =&gt; this.setCommercialPanelView('product_main', 'table')" aria-label="Ver tabla"><i class="fa fa-table"/></button>
                            <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-on-click="() =&gt; this.setCommercialTab('portafolio')" aria-label="Ver portafolio">
                                <i class="fa fa-arrow-right"/>
                            </button>
                        </div>
                    </div>
                    <t t-if="getCommercialPanelView('product_main') === 'chart'">
                    <div class="zrn_analitics_commercial_chart_container zrn_analitics_commercial_table_surface" style="height: 340px;">
                        <t t-if="hasEchartsLibrary">
                            <div class="w-100 h-100" data-zrn-chart="product-chart"/>
                        </t>
                        <t t-else="">
                            <div class="zrn_analitics_commercial_chart_empty">Librería ECharts no disponible.</div>
                        </t>
                    </div>
                    </t>
                    <t t-if="getCommercialPanelView('product_main') === 'table'">
                    <div class="zrn_analitics_commercial_table_wrap" style="max-height: 600px; overflow-y: auto;">
                        <table class="zrn_analitics_commercial_table">
                            <thead>
                                <tr>
                                    <th t-on-click="() =&gt; this.toggleSort('all_products', 'name')" style="cursor:pointer">Producto <i class="fa fa-sort ms-1 text-muted"/></th>
                                    <th t-on-click="() =&gt; this.toggleSort('all_products', 'brand')" style="cursor:pointer">Marca <i class="fa fa-sort ms-1 text-muted"/></th>
                                    <th>Categoría</th>
                                    <th t-on-click="() =&gt; this.toggleSort('all_products', 'rev')" style="cursor:pointer; text-align:right">Revenue YTD <i class="fa fa-sort ms-1 text-muted"/></th>
                                    <th t-on-click="() =&gt; this.toggleSort('all_products', 'units')" style="cursor:pointer; text-align:right">Unidades <i class="fa fa-sort ms-1 text-muted"/></th>
                                    <th style="text-align:right">% Venta</th>
                                    <th style="text-align:right">Líneas (Pedidos)</th>
                                    <th style="text-align:right">Canales</th>
                                    <th style="text-align:right">Precio real prom.</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="sortedAllProducts" t-as="item" t-key="item.product_id">
                                    <tr t-on-click="() =&gt; this.openAnalyticsDetailModal(item.detail)" style="cursor: pointer;">
                                        <td><strong><t t-esc="item.name"/></strong></td>
                                        <td><t t-esc="item.brand"/></td>
                                        <td><t t-esc="item.category"/></td>
                                        <td style="text-align:right; font-weight:600;"><t t-esc="commercialPayload.summary.currency_symbol"/> <t t-esc="formatMoney(item.rev)"/></td>
                                        <td style="text-align:right"><t t-esc="formatCount(item.units)"/></td>
                                        <td style="text-align:right"><t t-esc="Math.round(item.rev / commercialPayload.summary.total_amount * 1000) / 10"/>%</td>
                                        <td style="text-align:right"><t t-esc="formatCount(item.n_lines)"/></td>
                                        <td style="text-align:right"><t t-esc="formatCount(item.channels)"/></td>
                                        <td style="text-align:right; font-weight:600;"><t t-esc="commercialPayload.summary.currency_symbol"/> <t t-esc="formatMoney(item.avg_unit_price_real)"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                    </t>
                </section>
                <t t-if="state.productChartConfigOpen">
                    <div class="modal-backdrop fade show zrn_analitics_commercial_modal_backdrop" t-on-click="closeProductChartConfig"/>
                    <div class="modal fade show d-block zrn_analitics_product_chart_modal" tabindex="-1" role="dialog">
                        <div class="modal-dialog modal-dialog-centered" role="document" t-on-click.stop="">
                            <div class="modal-content zrn_analitics_commercial_modal">
                                <div class="zrn_analitics_commercial_modal_head"><strong>Configurar gráfica por producto</strong><button type="button" class="btn zrn_analitics_commercial_icon_btn" t-on-click="closeProductChartConfig" aria-label="Cerrar"><i class="fa fa-times"/></button></div>
                                <div class="zrn_analitics_commercial_modal_body">
                                    <label class="form-label">Métrica</label>
                                    <select class="form-select" t-att-value="state.productChartMetric" t-on-change="setProductChartMetric">
                                        <t t-foreach="productChartMetricOptions" t-as="metric" t-key="metric.key"><option t-att-value="metric.key"><t t-esc="metric.label"/></option></t>
                                    </select>
                                    <label class="form-label mt-3">Tipo de gráfica</label>
                                    <div class="btn-group" role="group">
                                        <button type="button" class="btn btn-outline-secondary" t-att-class="state.productChartType === 'bar' ? 'active' : ''" t-on-click="() =&gt; this.setProductChartType('bar')">Barras</button>
                                        <button type="button" class="btn btn-outline-secondary" t-att-class="state.productChartType === 'line' ? 'active' : ''" t-on-click="() =&gt; this.setProductChartType('line')">Línea</button>
                                        <button type="button" class="btn btn-outline-secondary" t-att-class="state.productChartType === 'pie' ? 'active' : ''" t-on-click="() =&gt; this.setProductChartType('pie')">Circular</button>
                                    </div>
                                </div>
                                <div class="zrn_analitics_commercial_modal_footer"><button type="button" class="btn btn-primary" t-on-click="closeProductChartConfig">Aplicar</button></div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>

            </t>
</templates>
