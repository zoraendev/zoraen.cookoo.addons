<?xml version='1.0' encoding='UTF-8'?>
<templates xml:space="preserve">
  <t t-name="zrn_analitics.HubCommercialTabTendencias"><t t-if="!state.commercialLoading &amp;&amp; state.commercialTab === 'tendencias'">
                <t t-call="zrn_analitics.HubCommercialFilters"/>
                <section class="zrn_analitics_hub_panel">
                    <div class="zrn_analitics_commercial_panel_head">
                        <span>Tendencia y Crecimiento de Ventas</span>
                        <div class="zrn_analitics_commercial_panel_actions">
                            <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-on-click="() =&gt; this.setCommercialTab('producto')" aria-label="Ver productos">
                                <i class="fa fa-arrow-right"/>
                            </button>
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <div class="zrn_analitics_hub_panel h-100">
                                <div class="zrn_analitics_commercial_panel_head">
                                    <span>Productos en crecimiento</span>
                                    <div class="zrn_analitics_commercial_panel_actions">
                                        <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-att-class="getCommercialPanelView('trends_growers') === 'chart' ? 'is-active' : ''" t-on-click="() =&gt; this.setCommercialPanelView('trends_growers', 'chart')" aria-label="Ver gráfica"><i class="fa fa-bar-chart"/></button>
                                        <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-on-click="(ev) =&gt; this.exportCommercialVisibleContent(ev, { chartKey: 'trends-growers', filename: 'zrn_comercial_productos_crecimiento' })" aria-label="Exportar crecimiento"><i class="fa fa-download"/></button>
                                        <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-att-class="getCommercialPanelView('trends_growers') === 'table' ? 'is-active' : ''" t-on-click="() =&gt; this.setCommercialPanelView('trends_growers', 'table')" aria-label="Ver tabla"><i class="fa fa-table"/></button>
                                    </div>
                                </div>
                                <t t-if="getCommercialPanelView('trends_growers') === 'chart'">
                                <div class="zrn_analitics_commercial_chart_container zrn_analitics_commercial_table_surface" style="height: 280px;">
                                    <div class="w-100 h-100" data-zrn-chart="trends-growers"/>
                                </div>
                                </t>
                                <t t-if="getCommercialPanelView('trends_growers') === 'table'">
                                <div class="zrn_analitics_commercial_table_wrap" style="max-height: 480px; overflow-y: auto;">
                                    <table class="zrn_analitics_commercial_table">
                                        <thead>
                                            <tr>
                                                <th>Producto</th>
                                                <th style="text-align:right">Pace Histórico/Día</th>
                                                <th style="text-align:right">Pace Reciente/Día</th>
                                                <th t-on-click="() =&gt; this.toggleSort('growers', 'trend')" style="cursor:pointer; text-align:right">Crecimiento Δ % <i class="fa fa-sort ms-1 text-muted"/></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="sortedGrowers" t-as="g" t-key="g.name">
                                                <tr t-on-click="() =&gt; this.openAnalyticsDetailModal(g.detail)" style="cursor: pointer;">
                                                    <td><strong><t t-esc="g.name"/></strong></td>
                                                    <td style="text-align:right"><t t-esc="g.pace_q1_u"/> u/día</td>
                                                    <td style="text-align:right"><t t-esc="g.pace_abr_u"/> u/día</td>
                                                    <td style="text-align:right; font-weight:700; color:#16a34a;">
                                                        +<t t-esc="g.trend"/>%
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                                </t>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="zrn_analitics_hub_panel h-100">
                                <div class="zrn_analitics_commercial_panel_head">
                                    <span>Productos en caída</span>
                                    <div class="zrn_analitics_commercial_panel_actions">
                                        <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-att-class="getCommercialPanelView('trends_decliners') === 'chart' ? 'is-active' : ''" t-on-click="() =&gt; this.setCommercialPanelView('trends_decliners', 'chart')" aria-label="Ver gráfica"><i class="fa fa-bar-chart"/></button>
                                        <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-on-click="(ev) =&gt; this.exportCommercialVisibleContent(ev, { chartKey: 'trends-decliners', filename: 'zrn_comercial_productos_caida' })" aria-label="Exportar caída"><i class="fa fa-download"/></button>
                                        <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-att-class="getCommercialPanelView('trends_decliners') === 'table' ? 'is-active' : ''" t-on-click="() =&gt; this.setCommercialPanelView('trends_decliners', 'table')" aria-label="Ver tabla"><i class="fa fa-table"/></button>
                                    </div>
                                </div>
                                <t t-if="getCommercialPanelView('trends_decliners') === 'chart'">
                                <div class="zrn_analitics_commercial_chart_container zrn_analitics_commercial_table_surface" style="height: 280px;">
                                    <div class="w-100 h-100" data-zrn-chart="trends-decliners"/>
                                </div>
                                </t>
                                <t t-if="getCommercialPanelView('trends_decliners') === 'table'">
                                <div class="zrn_analitics_commercial_table_wrap" style="max-height: 480px; overflow-y: auto;">
                                    <table class="zrn_analitics_commercial_table">
                                        <thead>
                                            <tr>
                                                <th>Producto</th>
                                                <th style="text-align:right">Pace Histórico/Día</th>
                                                <th style="text-align:right">Pace Reciente/Día</th>
                                                <th t-on-click="() =&gt; this.toggleSort('decliners', 'trend')" style="cursor:pointer; text-align:right">Caída Δ % <i class="fa fa-sort ms-1 text-muted"/></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="sortedDecliners" t-as="d" t-key="d.name">
                                                <tr t-on-click="() =&gt; this.openAnalyticsDetailModal(d.detail)" style="cursor: pointer;">
                                                    <td><strong><t t-esc="d.name"/></strong></td>
                                                    <td style="text-align:right"><t t-esc="d.pace_q1_u"/> u/día</td>
                                                    <td style="text-align:right"><t t-esc="d.pace_abr_u"/> u/día</td>
                                                    <td style="text-align:right; font-weight:700; color:#b91c1c;">
                                                        <t t-esc="d.trend"/>%
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </section>
            </t>

            </t>
</templates>
