<?xml version='1.0' encoding='UTF-8'?>
<templates xml:space="preserve">
  <t t-name="zrn_analitics.HubCommercialTabCliente"><t t-if="!state.commercialLoading &amp;&amp; state.commercialTab === 'cliente'">
                <t t-call="zrn_analitics.HubCommercialFilters"/>
                <section class="zrn_analitics_hub_panel">
                    <div class="zrn_analitics_commercial_panel_head">
                        <span>Ranking completo de clientes / PDVs</span>
                        <div class="zrn_analitics_commercial_panel_actions">
                            <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-att-class="getCommercialPanelView('client_main') === 'chart' ? 'is-active' : ''" t-on-click="() =&gt; this.setCommercialPanelView('client_main', 'chart')" aria-label="Ver gráfica"><i class="fa fa-bar-chart"/></button>
                            <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-on-click="toggleClientChartConfig" aria-label="Configurar gráfica"><i class="fa fa-sliders"/></button>
                            <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-on-click="(ev) =&gt; this.exportCommercialVisibleContent(ev, { chartKey: 'client-main', filename: 'zrn_comercial_clientes_pdv' })" aria-label="Exportar clientes">
                                <i class="fa fa-download"/>
                            </button>
                            <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-att-class="getCommercialPanelView('client_main') === 'table' ? 'is-active' : ''" t-on-click="() =&gt; this.setCommercialPanelView('client_main', 'table')" aria-label="Ver tabla"><i class="fa fa-table"/></button>
                            <button type="button" class="btn zrn_analitics_commercial_icon_btn" t-on-click="() =&gt; this.setCommercialTab('canal')" aria-label="Ver canales">
                                <i class="fa fa-arrow-right"/>
                            </button>
                        </div>
                    </div>
                    <t t-if="getCommercialPanelView('client_main') === 'chart'">
                    <div class="zrn_analitics_commercial_chart_container zrn_analitics_commercial_table_surface" style="height: 340px;">
                        <t t-if="hasEchartsLibrary">
                            <div class="w-100 h-100" data-zrn-chart="client-main"/>
                        </t>
                        <t t-else="">
                            <div class="zrn_analitics_commercial_chart_empty">Librería ECharts no disponible.</div>
                        </t>
                    </div>
                    </t>
                    <t t-if="getCommercialPanelView('client_main') === 'table'">
                    <div class="zrn_analitics_commercial_table_wrap" style="max-height: 600px; overflow-y: auto;">
                        <table class="zrn_analitics_commercial_table">
                            <thead>
                                <tr>
                                    <th t-on-click="() =&gt; this.toggleSort('all_clients', 'name')" style="cursor:pointer">Cliente / PDV <i class="fa fa-sort ms-1 text-muted"/></th>
                                    <th t-on-click="() =&gt; this.toggleSort('all_clients', 'channel')" style="cursor:pointer">Canal <i class="fa fa-sort ms-1 text-muted"/></th>
                                    <th t-on-click="() =&gt; this.toggleSort('all_clients', 'rev')" style="cursor:pointer; text-align:right">Facturado <i class="fa fa-sort ms-1 text-muted"/></th>
                                    <th t-on-click="() =&gt; this.toggleSort('all_clients', 'units')" style="cursor:pointer; text-align:right">Unidades <i class="fa fa-sort ms-1 text-muted"/></th>
                                    <th t-on-click="() =&gt; this.toggleSort('all_clients', 'invoices')" style="cursor:pointer; text-align:right">Facturas <i class="fa fa-sort ms-1 text-muted"/></th>
                                    <th style="text-align:right">Ticket prom.</th>
                                    <th>Primera compra</th>
                                    <th>Última compra</th>
                                    <th t-on-click="() =&gt; this.toggleSort('all_clients', 'days_since')" style="cursor:pointer; text-align:right">Días sin facturar <i class="fa fa-sort ms-1 text-muted"/></th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="sortedAllClients" t-as="item" t-key="item.id">
                                    <tr t-on-click="() =&gt; this.openAnalyticsDetailModal(item.detail)" style="cursor: pointer;">
                                        <td><strong><t t-esc="item.name"/></strong></td>
                                        <td><span class="badge bg-light text-dark"><t t-esc="item.channel"/></span></td>
                                        <td style="text-align:right; font-weight:600;"><t t-esc="commercialPayload.summary.currency_symbol"/> <t t-esc="formatMoney(item.rev)"/></td>
                                        <td style="text-align:right"><t t-esc="formatCount(item.units)"/></td>
                                        <td style="text-align:right"><t t-esc="formatCount(item.invoices)"/></td>
                                        <td style="text-align:right"><t t-esc="commercialPayload.summary.currency_symbol"/> <t t-esc="formatMoney(item.rev / item.invoices)"/></td>
                                        <td><t t-esc="item.first"/></td>
                                        <td><t t-esc="item.last"/></td>
                                        <td style="text-align:right; font-weight:600;" t-att-class="item.days_since &gt;= 30 ? 'text-danger' : (item.days_since &gt;= 14 ? 'text-warning' : 'text-success')">
                                            <t t-esc="item.days_since"/> días
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                    </t>
                </section>
                <t t-if="state.clientChartConfigOpen">
                    <div class="modal-backdrop fade show zrn_analitics_commercial_modal_backdrop" t-on-click="closeClientChartConfig"/>
                    <div class="modal fade show d-block zrn_analitics_client_chart_modal" tabindex="-1" role="dialog">
                        <div class="modal-dialog modal-dialog-centered" role="document" t-on-click.stop="">
                            <div class="modal-content zrn_analitics_commercial_modal">
                                <div class="zrn_analitics_commercial_modal_head"><strong>Configurar gráfica por cliente</strong><button type="button" class="btn zrn_analitics_commercial_icon_btn" t-on-click="closeClientChartConfig" aria-label="Cerrar"><i class="fa fa-times"/></button></div>
                                <div class="zrn_analitics_commercial_modal_body">
                                    <label class="form-label">Métrica</label>
                                    <select class="form-select" t-att-value="state.clientChartMetric" t-on-change="setClientChartMetric">
                                        <t t-foreach="clientChartMetricOptions" t-as="metric" t-key="metric.key"><option t-att-value="metric.key"><t t-esc="metric.label"/></option></t>
                                    </select>
                                    <label class="form-label mt-3">Tipo de gráfica</label>
                                    <div class="btn-group" role="group">
                                        <button type="button" class="btn btn-outline-secondary" t-att-class="state.clientChartType === 'bar' ? 'active' : ''" t-on-click="() =&gt; this.setClientChartType('bar')">Barras</button>
                                        <button type="button" class="btn btn-outline-secondary" t-att-class="state.clientChartType === 'line' ? 'active' : ''" t-on-click="() =&gt; this.setClientChartType('line')">Línea</button>
                                        <button type="button" class="btn btn-outline-secondary" t-att-class="state.clientChartType === 'pie' ? 'active' : ''" t-on-click="() =&gt; this.setClientChartType('pie')">Circular</button>
                                    </div>
                                </div>
                                <div class="zrn_analitics_commercial_modal_footer"><button type="button" class="btn btn-primary" t-on-click="closeClientChartConfig">Aplicar</button></div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>

            </t>
</templates>
