<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="zrn_analitics.RelationalSingleSelect">
        <div class="zrn_analitics_relational_single o_field_widget o_field_many2one" t-att-class="props.record ? 'is-selected' : 'is-empty'">
            <div class="zrn_analitics_relational_single_control o_input">
                <div class="zrn_analitics_relational_single_value" t-if="props.record">
                    <span class="zrn_analitics_relational_single_text"><t t-esc="props.record.display_name"/></span>
                    <button
                        t-if="props.canClear"
                        type="button"
                        class="btn zrn_analitics_relational_single_clear"
                        t-on-click="clearSelection"
                        aria-label="Limpiar seleccion"
                    >
                        <i class="fa fa-times"></i>
                    </button>
                </div>
                <div class="zrn_analitics_relational_single_picker" t-if="!props.record">
                    <Many2XAutocomplete
                        placeholder="props.placeholder"
                        resModel="props.resModel"
                        fieldString="props.fieldString"
                        activeActions="activeActions"
                        update.bind="updateRecord"
                        getDomain.bind="getDomain"
                        isToMany="false"
                        autoSelect="true"
                        context="props.context"
                    />
                    <span class="zrn_analitics_relational_single_icon" aria-hidden="true">
                        <i class="fa fa-angle-down"></i>
                    </span>
                </div>
            </div>
        </div>
    </t>

    <t t-name="zrn_analitics.HubAction">
        <div class="zrn_analitics_hub_workspace">
            <div class="zrn_analitics_hub_header">
                <div class="zrn_analitics_hub_header_actions">
                    <button
                        type="button"
                        class="btn zrn_analitics_hub_back_btn"
                        t-on-click="openHome"
                    >
                        <i class="fa fa-arrow-left"></i>
                        <span>Regresar</span>
                    </button>
                </div>
                <div class="zrn_analitics_hub_switcher">
                    <span class="zrn_analitics_hub_switcher_label">Hub</span>
                    <div class="dropdown zrn_analitics_hub_dropdown" t-att-class="state.hubMenuOpen ? 'show' : ''">
                        <button
                            type="button"
                            class="btn dropdown-toggle zrn_analitics_hub_dropdown_btn"
                            t-att-aria-expanded="state.hubMenuOpen ? 'true' : 'false'"
                            t-on-click="toggleHubMenu"
                        >
                            <t t-esc="activeHub.label"/>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end zrn_analitics_hub_dropdown_menu" t-att-class="state.hubMenuOpen ? 'show' : ''">
                        <t t-foreach="hubs" t-as="hub" t-key="hub.key">
                            <button
                                type="button"
                                class="dropdown-item zrn_analitics_hub_dropdown_item"
                                t-att-class="state.activeHub === hub.key ? 'active' : ''"
                                t-on-click="() => this.setActiveHub(hub.key)"
                            >
                                <t t-esc="hub.label"/>
                            </button>
                        </t>
                        </div>
                    </div>
                </div>
            </div>

            <div class="zrn_analitics_hub_body">
                <t t-if="activeHub.key === 'commercial'" t-call="zrn_analitics.HubCommercial"/>
                <t t-if="activeHub.key === 'financial'" t-call="zrn_analitics.HubFinancial"/>
                <t t-if="activeHub.key === 'operations'" t-call="zrn_analitics.HubOperations"/>
                <t t-if="activeHub.key === 'pdv'" t-call="zrn_analitics.HubPdv"/>
                <t t-if="activeHub.key === 'rrhh'" t-call="zrn_analitics.HubRrhh"/>
            </div>
        </div>
    </t>
</templates>
